---
import Base from '../layouts/Base.astro';
import Turntable from '../components/Turntable.astro';
import Photo from '../components/Photo.astro';
import { univers } from '../data/univers.js';
import { site } from '../data/site.js';

// Partenaires — logos dans public/img/partenaires/. Pour en ajouter un,
// déposer le fichier et compléter ce tableau (traitement/hover automatiques).
const partners = [
  { src: '/img/partenaires/courtier-pontissalien.png', name: 'Courtier Pontissalien', url: 'https://courtier-pontissalien.com' },
  { src: '/img/partenaires/decathlon.png', name: 'Décathlon', url: 'https://www.decathlon.fr' },
];
// Bandeau défilant : on répète la liste pour remplir la piste et boucler sans
// couture, même avec peu de partenaires.
const partnersLoop = Array.from({ length: 4 }).flatMap(() => partners);

// Données structurées : l'association sportive, son adresse et ses réseaux.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': ['SportsOrganization', 'SportsClub'],
  name: 'VELCAP',
  url: 'https://velcap.fr',
  logo: 'https://velcap.fr/img/velcap-logo.svg',
  image: 'https://velcap.fr/img/og-velcap.jpg',
  description:
    "Collectif sportif à Besançon : course à pied loisir et compétition (club FFA), cyclisme (club FFC), team élite, événements et coaching.",
  email: site.email,
  telephone: '+33750455758',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '15 rue de la Combe',
    postalCode: '25750',
    addressLocality: 'Désandans',
    addressCountry: 'FR',
  },
  areaServed: { '@type': 'City', name: 'Besançon' },
  sport: ['Course à pied', 'Trail', 'Athlétisme', 'Cyclisme'],
  sameAs: site.socials.map((s) => s.url),
};
---
<Base
  title="VELCAP · Course à pied et cyclisme à Besançon"
  description="VELCAP, collectif sportif bisontin : course à pied loisir et compétition (club FFA), cyclisme (club FFC), team élite, événements toute l'année et coaching individualisé."
  jsonLd={jsonLd}
>
  <!-- ============ HERO ============ -->
  <section class="hero" data-parallax-scope>
    <div class="container hero__inner">
      <h1 class="hero__kicker mono eyebrow" data-intro data-intro-order="1">Une structure. Six univers. Un seul cap.</h1>

      <img class="hero__logo" src="/img/velcap-logo.svg" alt="VELCAP" width="447" height="140" data-intro="clip" data-intro-order="2" />

      <div class="hero__pitch" data-intro data-intro-order="3">
        <p class="hero__lead">
          Deux cyclistes, quatre coureurs, un collectif né à Besançon.
          Course à pied ou vélo, loisir ou haut niveau : six univers sous le même maillot.
          <strong>Il ne te reste plus qu'à trouver ton CAP !</strong>
        </p>
        <div class="hero__cta">
          <a class="btn btn--red btn--lg" href="#univers" data-magnetic>
            Explorer les univers <span class="arrow" aria-hidden="true">→</span>
          </a>
          <a class="btn btn--dark btn--lg" href="#engager" data-magnetic>
            S'engager <span class="arrow" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>

    <div class="hero__media" data-intro="clip" data-intro-order="4">
      <Photo src="photo-hero.jpg" treatment="color" slug="club-ffa" parallax="6"
             alt="Athlète VELCAP" pos="center 35%" />
    </div>
  </section>

  <!-- ============ MARQUEE ============ -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      {Array.from({ length: 2 }).map(() => (
        <span class="marquee__row">
          {univers.map((u) => (
            <span class="marquee__item">{u.name}<span class="marquee__star">✳</span></span>
          ))}
        </span>
      ))}
    </div>
  </div>

  <!-- ============ PLATEFORME TOURNANTE (NOS UNIVERS) ============ -->
  <Turntable />

  <!-- ============ BANDEAU ÉMOTION (pleine largeur) ============ -->
  <section class="photoband" data-parallax-scope aria-label="VELCAP, le collectif">
    <Photo src="photo-band.jpg" treatment="color" slug="corrida" parallax="12"
           alt="Deux athlètes VELCAP se prennent dans les bras à l'arrivée" class="photoband__media" />
    <div class="photoband__overlay">
      <div class="container">
        <p class="mono eyebrow" data-reveal>Le collectif</p>
        <p class="photoband__line display" data-reveal data-delay="0.05">
          On franchit<br />la ligne <span class="accent">ensemble.</span>
        </p>
      </div>
    </div>
  </section>

  <!-- ============ STATS / ROSTER (dark) ============ -->
  <section class="section section--dark roster" data-parallax-scope>
    <div class="container">
      <p class="mono eyebrow" data-reveal>Pourquoi VELCAP</p>
      <div class="roster__grid" data-reveal-group>
        <div class="roster__row" data-reveal-item>
          <span class="roster__k mono">Tous niveaux</span>
          <span class="roster__v display">De l'athlète débutant à l'élite. Du premier dossard au podium.</span>
        </div>
        <div class="roster__row" data-reveal-item>
          <span class="roster__k mono">Collectif</span>
          <span class="roster__v display">Esprit d'équipe, convivialité, solidarité.</span>
        </div>
        <div class="roster__row" data-reveal-item>
          <span class="roster__k mono">Encadrement</span>
          <span class="roster__v display">Quel que soit ton objectif, un coach est là pour t'écouter et te guider.</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ PARTENAIRES (bandeau défilant) ============ -->
  <section class="section partners" aria-label="Nos partenaires">
    <div class="container">
      <p class="mono eyebrow" data-reveal>Ils nous soutiennent</p>
    </div>
    <div class="container">
      {/* Liens accessibles (clavier / lecteurs d'écran) : le bandeau défilant
          répète les logos, donc ses liens sont décoratifs. Ceux-ci, discrets,
          apparaissent au focus clavier. */}
      <ul class="partners__links">
        {partners.map((p) => (
          <li>
            <a href={p.url} target="_blank" rel="noopener noreferrer">Site de {p.name}</a>
          </li>
        ))}
      </ul>
    </div>
    <div class="partners__viewport" data-reveal>
      <div class="partners__track">
        {Array.from({ length: 2 }).map(() => (
          <div class="partners__set" aria-hidden="true">
            {partnersLoop.map((p) => (
              <a
                class="partners__logo"
                href={p.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Site de ${p.name}`}
                tabindex="-1"
              >
                <img class="partners__img" src={p.src} alt="" loading="lazy" decoding="async" />
              </a>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ ENGAGER ============ -->
  <section class="section engager" id="engager">
    <div class="container engager__grid">
      <div class="engager__head">
        <div data-reveal>
          <p class="mono eyebrow">Rejoindre la structure</p>
          <h2 class="engager__title display">On t'attend sur<br />la ligne de départ.</h2>
          <p class="engager__lead">Licence, essai, bénévolat ou coaching : dis-nous ce qui t'amène, on s'occupe du reste.</p>
          <p class="engager__alt mono">Tu préfères écrire ? <a href="/contact">Va sur la page contact →</a></p>
        </div>
        <div class="engager__media" data-reveal data-delay="0.05">
          <Photo src="photo-engage.jpg" treatment="bw" slug="association" parallax="7"
                 alt="L'équipe VELCAP" />
        </div>
      </div>

      <form class="engager__form" data-engage-form data-reveal data-delay="0.1" novalidate>
        <input type="hidden" name="access_key" value={site.web3formsKey} />
        <input type="hidden" name="subject" value="Nouvelle demande (accueil) - site VELCAP" />
        <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="field">
          <label class="mono" for="f-firstname">Prénom</label>
          <input id="f-firstname" name="firstname" type="text" placeholder="Ton prénom" required />
        </div>
        <div class="field">
          <label class="mono" for="f-name">Nom</label>
          <input id="f-name" name="name" type="text" placeholder="Ton nom" required />
        </div>
        <div class="field">
          <label class="mono" for="f-email">E-mail</label>
          <input id="f-email" name="email" type="email" placeholder="toi@exemple.fr" required />
        </div>
        <div class="field">
          <label class="mono" for="f-interest">Je veux</label>
          <select id="f-interest" name="interest" required>
            <option value="" disabled selected>Choisir…</option>
            {univers.filter((u) => u.slug !== 'club-ffc' && u.slug !== 'evenements').map((u) => <option data-slug={u.slug}>{u.cta}</option>)}
            <option>Demander un partenariat</option>
            <option>Créer ou participer à un événement</option>
          </select>
        </div>
        <div class="field">
          <label class="mono" for="f-precision">Précise ta demande</label>
          <textarea id="f-precision" name="message" rows="4" placeholder="Dis-nous ce que tu recherches…"></textarea>
        </div>
        <label class="consent">
          <input type="checkbox" name="rgpd" required />
          <span>J'accepte que mes données soient utilisées pour traiter ma demande (voir la <a href="/confidentialite" target="_blank">Politique de confidentialité</a>). *</span>
        </label>
        <button type="submit" class="btn btn--red">Envoyer ma demande <span class="arrow" aria-hidden="true">→</span></button>
        <p class="engager__feedback mono" data-engage-feedback role="status"></p>
      </form>
    </div>
  </section>
</Base>

<style>
  /* — Hero (centré) — */
  .hero { position: relative; padding-block: 6.5rem 0; }
  .hero__inner { width: 100%; text-align: center; }
  .hero__kicker { margin-bottom: 1.1rem; justify-content: center; }
  /* logo centré, un peu plus petit */
  .hero__logo { width: 100%; max-width: min(78vw, 900px); height: auto; margin: 0 auto clamp(1.6rem, 3vw, 2.6rem); }
  /* accroche étendue et centrée, boutons centrés juste en dessous */
  .hero__pitch { display: flex; flex-direction: column; align-items: center; }
  .hero__lead { font-size: var(--fs-lead); max-width: min(94%, 720px); margin-inline: auto; color: #2a2a2e; line-height: 1.45; text-align: center; }
  .hero__lead strong { color: var(--ink); font-weight: 700; }
  .hero__cta { display: flex; gap: 1rem; margin-top: clamp(1.6rem, 3vw, 2.4rem); flex-wrap: wrap; justify-content: center; }

  /* photo du hero : bandeau pleine largeur (full-bleed, bord à bord) */
  .hero__media {
    position: relative; width: 100%; height: clamp(360px, 66vh, 760px);
    margin-top: clamp(2rem, 5vw, 3.5rem); overflow: hidden;
  }
  .hero__media-tag {
    position: absolute; left: clamp(1rem, 4vw, 3.2rem); bottom: 0.9rem; z-index: 3;
    color: rgba(255,255,255,.85); background: rgba(10,10,11,.45); backdrop-filter: blur(3px);
    padding: 0.3rem 0.65rem; border-radius: 5px;
  }

  /* — Marquee — */
  .marquee { background: var(--ink); color: var(--white); padding-block: 1.1rem; overflow: hidden; border-block: 1px solid var(--ink); }
  .marquee__track { display: flex; width: max-content; animation: marquee 38s linear infinite; }
  .marquee__row { display: flex; }
  .marquee__item { font-family: var(--font-display); font-weight: 600; text-transform: uppercase; font-size: clamp(1.6rem, 4vw, 2.8rem); letter-spacing: -0.01em; display: inline-flex; align-items: center; padding-inline: 1.2rem; white-space: nowrap; }
  .marquee__star { color: var(--red-bright); margin-left: 2.4rem; font-size: 0.6em; }
  @keyframes marquee { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .marquee__track { animation: none; } }

  /* — Bandeau émotion (pleine largeur, ample) — */
  .photoband { position: relative; height: clamp(440px, 74vh, 760px); overflow: hidden; }
  .photoband__media { position: absolute; inset: 0; }
  .photoband__overlay {
    position: absolute; inset: 0; z-index: 2; display: flex; flex-direction: column; justify-content: flex-end;
    padding-block: clamp(1.5rem, 5vw, 4rem); color: #fff;
    background: linear-gradient(to top, rgba(8,8,10,.74), rgba(8,8,10,.12) 55%, transparent);
  }
  .photoband__overlay .eyebrow { color: #fff; }
  .photoband__line { font-size: clamp(2.4rem, 7vw, 6rem); }
  .photoband__line .accent { color: var(--red-bright); }

  /* — Roster (dark) — */
  .roster__grid { margin-top: 1.5rem; }
  .roster__row { display: grid; grid-template-columns: 12rem 1fr; gap: 1.5rem; align-items: baseline; padding-block: clamp(1.4rem, 3vw, 2.4rem); border-top: 1px solid var(--hairline-d); }
  .roster__row:last-child { border-bottom: 1px solid var(--hairline-d); }
  .roster__k { color: var(--red-bright); }
  .roster__v { font-size: clamp(1.6rem, 4.5vw, 3.2rem); }

  /* — Partenaires — */
  .partners__viewport {
    overflow: hidden; margin-top: 1.6rem;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
    /* confine le compositing du masque/défilement à ce conteneur : un repeint
       du bandeau ne peut plus altérer le bord de la section au-dessus */
    isolation: isolate;
  }
  .partners__track { display: flex; width: max-content; animation: partners 30s linear infinite; }
  .partners__viewport:hover .partners__track { animation-play-state: paused; }
  .partners__set { display: flex; align-items: center; }
  /* carte à largeur libre : chaque logo garde une hauteur commune (taille harmonisée) */
  .partners__logo {
    flex: 0 0 auto; height: 96px; margin-inline: clamp(0.5rem, 1.2vw, 1.1rem);
    padding-inline: clamp(1.2rem, 2.4vw, 2rem);
    display: grid; place-items: center; background: var(--white);
    border: 1px solid var(--hairline); border-radius: 12px;
    text-decoration: none; cursor: pointer;
    transition: border-color 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }
  .partners__logo:focus-visible { outline: 2px solid var(--red); outline-offset: 3px; }
  .partners__img {
    height: clamp(30px, 4vw, 42px); width: auto; max-width: clamp(150px, 24vw, 260px);
    object-fit: contain; display: block;
    filter: grayscale(1); opacity: 0.9;
    transition: filter 0.35s var(--ease), opacity 0.35s var(--ease);
  }
  /* hover sobre : bord rouge + ombre douce, le logo reprend ses couleurs.
     Pas de transform ici : il promeut la carte sur sa propre couche de
     composition et, combiné au masque du bandeau, fait « sauter » le repeint
     du bord de la section sombre au-dessus (bug WebKit). */
  .partners__logo:hover { border-color: var(--red); box-shadow: 0 16px 32px -18px rgba(226, 0, 15, 0.42); }
  .partners__logo:hover .partners__img { filter: grayscale(0); opacity: 1; }
  /* Liens accessibles : hors flux, révélés au focus clavier (le bandeau reste décoratif) */
  .partners__links { list-style: none; display: flex; flex-wrap: wrap; gap: 0.6rem; margin: 0; padding: 0; }
  .partners__links a {
    position: absolute; width: 1px; height: 1px; overflow: hidden;
    clip: rect(0 0 0 0); white-space: nowrap;
  }
  .partners__links a:focus {
    position: static; width: auto; height: auto; clip: auto; white-space: normal;
    display: inline-block; margin-top: 0.8rem; padding: 0.4rem 0.7rem;
    font-family: var(--font-mono); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.1em;
    color: var(--red); border: 1px solid var(--red); border-radius: 999px;
    outline: 2px solid var(--red); outline-offset: 2px;
  }
  @keyframes partners { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .partners__track { animation: none; } }

  /* — Engager — */
  .engager__grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .engager__head { display: flex; flex-direction: column; gap: clamp(1.4rem, 3vw, 2.2rem); }
  .engager__media { aspect-ratio: 16 / 10; border-radius: 14px; overflow: hidden; box-shadow: var(--shadow); }
  .engager__title { font-size: var(--fs-h2); margin: 0.8rem 0 1rem; }
  .engager__lead { font-size: var(--fs-lead); color: #4a4a50; max-width: 36ch; }
  .engager__alt { margin-top: 1rem; color: var(--smoke); text-transform: none; letter-spacing: 0.04em; }
  .engager__alt a { color: var(--red); }
  .engager__alt a:hover { text-decoration: underline; }
  .engager__form { display: grid; gap: 1rem; background: var(--ink); color: #fff; padding: clamp(1.5rem, 3vw, 2.4rem); border-radius: 16px; }
  .field { display: grid; gap: 0.4rem; }
  .field label { color: #8a8a90; }
  .field input, .field select, .field textarea {
    background: #15151a; border: 1px solid #2a2a31; border-radius: 9px; padding: 0.85rem 1rem; color: #fff;
    font: inherit;
  }
  .field textarea { resize: vertical; min-height: 3.4rem; }
  .field input::placeholder, .field textarea::placeholder { color: #6a6a72; }
  .field input:focus, .field select:focus, .field textarea:focus { outline: 2px solid var(--red); border-color: var(--red); }
  .engager__form .btn { justify-content: center; margin-top: 0.4rem; }
  .engager__feedback { color: var(--red-bright); min-height: 1.2em; text-transform: none; letter-spacing: 0; }
  .engager__form .consent { display: flex; align-items: flex-start; gap: 0.6rem; font-size: 0.85rem; color: #b9b9c0; line-height: 1.4; cursor: pointer; }
  .engager__form .consent input { width: auto; margin-top: 0.2rem; accent-color: var(--red); flex-shrink: 0; }
  .engager__form .consent a { color: var(--red-bright); text-decoration: underline; }

  @media (max-width: 860px) {
    .hero__media { height: clamp(300px, 52vh, 520px); }
    .roster__row { grid-template-columns: 1fr; gap: 0.4rem; }
    .engager__grid { grid-template-columns: 1fr; }
  }
</style>
