---
import Base from '../layouts/Base.astro';
import Turntable from '../components/Turntable.astro';
import Photo from '../components/Photo.astro';
import { univers } from '../data/univers.js';

// Emplacements partenaires — remplacer le libellé par une vraie image de logo
// dès qu'elle est fournie (public/img/partenaires/…).
const partners = ['Votre logo', 'Votre logo', 'Votre logo', 'Votre logo', 'Votre logo', 'Votre logo'];
---
<Base title="VELCAP · Une structure, six univers, un seul cap">
  <!-- ============ HERO ============ -->
  <section class="hero" data-parallax-scope>
    <div class="container hero__inner">
      <p class="hero__kicker mono eyebrow" data-intro data-intro-order="1">Une structure. Six univers. Un seul cap.</p>

      <img class="hero__logo" src="/img/velcap-logo.svg" alt="VELCAP" width="447" height="140" data-intro="clip" data-intro-order="2" />

      <div class="hero__bottom">
        <div class="hero__pitch" data-intro data-intro-order="3">
          <p class="hero__lead">
            Loisir, haut niveau, athlétisme, cyclisme, événements, coaching.
            VELCAP rassemble toutes les manières de se dépasser sous une même bannière,
            <strong>et te laisse choisir la tienne.</strong>
          </p>
          <div class="hero__cta">
            <a class="btn btn--red btn--lg" href="#univers" data-magnetic>
              Explorer les univers <span class="arrow" aria-hidden="true">→</span>
            </a>
            <a class="btn btn--dark btn--lg" href="#engager" data-magnetic>
              S'engager <span class="arrow" aria-hidden="true">↗</span>
            </a>
          </div>
        </div>

        <div class="hero__media" data-intro="clip" data-intro-order="4">
          <Photo src="photo-hero.jpg" treatment="color" slug="club-ffa" parallax="8"
                 alt="Athlète VELCAP" />
          <span class="hero__media-tag mono">Les Rives du Doubs, Besançon</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ MARQUEE ============ -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      {Array.from({ length: 2 }).map(() => (
        <span class="marquee__row">
          {univers.map((u) => (
            <span class="marquee__item">{u.name}<span class="marquee__star">✳</span></span>
          ))}
        </span>
      ))}
    </div>
  </div>

  <!-- ============ MANIFESTE ============ -->
  <section class="section manifesto" data-parallax-scope>
    <div class="container manifesto__grid">
      <div class="manifesto__text">
        <p class="mono eyebrow" data-reveal>Le projet</p>
        <p class="manifesto__statement display" data-reveal data-delay="0.05">
          Une seule licence.<br />Toutes les façons<br />de <span class="accent">tenir le cap.</span>
        </p>
        <p class="manifesto__copy" data-reveal data-delay="0.1">
          Du premier dossard au podium, VELCAP réunit le loisir, le haut niveau,
          l'athlétisme, le cyclisme, les événements et le coaching. Une même exigence :
          progresser ensemble, sans jamais courir seul.
        </p>
        <div class="manifesto__facts" data-reveal-group>
          <div class="manifesto__fact" data-reveal-item>
            <b class="display">Six univers</b><span class="mono">Une seule structure</span>
          </div>
          <div class="manifesto__fact" data-reveal-item>
            <b class="display">Deux fédérations</b><span class="mono">Athlétisme et cyclisme</span>
          </div>
          <div class="manifesto__fact" data-reveal-item>
            <b class="display accent">Un cap</b><span class="mono">Le collectif</span>
          </div>
        </div>
      </div>
      <div class="manifesto__media" data-reveal>
        <Photo src="photo-manifesto.jpg" treatment="bw" slug="club-ffc" parallax="9"
               alt="Coureurs VELCAP" />
      </div>
    </div>
  </section>

  <!-- ============ PLATEFORME TOURNANTE ============ -->
  <Turntable />

  <!-- ============ BANDEAU ÉMOTION (pleine largeur) ============ -->
  <section class="photoband" data-parallax-scope aria-label="VELCAP, le collectif">
    <Photo src="photo-band.jpg" treatment="color" slug="corrida" parallax="12"
           alt="Deux athlètes VELCAP se prennent dans les bras à l'arrivée" class="photoband__media" />
    <div class="photoband__overlay">
      <div class="container">
        <p class="mono eyebrow" data-reveal>Le collectif</p>
        <p class="photoband__line display" data-reveal data-delay="0.05">
          On franchit<br />la ligne <span class="accent">ensemble.</span>
        </p>
      </div>
    </div>
  </section>

  <!-- ============ STATS / ROSTER (dark) ============ -->
  <section class="section section--dark roster" data-parallax-scope>
    <div class="container">
      <p class="mono eyebrow" data-reveal>Pourquoi VELCAP</p>
      <div class="roster__grid" data-reveal-group>
        <div class="roster__row" data-reveal-item>
          <span class="roster__k mono">Tous niveaux</span>
          <span class="roster__v display">Du premier dossard au podium</span>
        </div>
        <div class="roster__row" data-reveal-item>
          <span class="roster__k mono">Encadrement</span>
          <span class="roster__v display">Des coachs qui te suivent vraiment</span>
        </div>
        <div class="roster__row" data-reveal-item>
          <span class="roster__k mono">Collectif</span>
          <span class="roster__v display">Le terrain, l'équipe, l'après-course</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ PARTENAIRES (bandeau défilant) ============ -->
  <section class="section partners" aria-label="Nos partenaires">
    <div class="container">
      <p class="mono eyebrow" data-reveal>Ils nous soutiennent</p>
    </div>
    <div class="partners__viewport" data-reveal>
      <div class="partners__track">
        {Array.from({ length: 2 }).map(() => (
          <div class="partners__set" aria-hidden="true">
            {partners.map(() => (
              <div class="partners__logo"><span class="mono">Votre logo</span></div>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ ENGAGER ============ -->
  <section class="section engager" id="engager">
    <div class="container engager__grid">
      <div class="engager__head">
        <div data-reveal>
          <p class="mono eyebrow">Rejoindre la structure</p>
          <h2 class="engager__title display">On t'attend sur<br />la ligne de départ.</h2>
          <p class="engager__lead">Licence, essai, bénévolat ou coaching : dis-nous ce qui t'amène, on s'occupe du reste.</p>
          <p class="engager__alt mono">Tu préfères écrire ? <a href="/contact">Va sur la page contact →</a></p>
        </div>
        <div class="engager__media" data-reveal data-delay="0.05">
          <Photo src="photo-engage.jpg" treatment="bw" slug="association" parallax="7"
                 alt="L'équipe VELCAP" />
        </div>
      </div>

      <form class="engager__form" data-engage-form data-reveal data-delay="0.1" novalidate>
        <div class="field">
          <label class="mono" for="f-firstname">Prénom</label>
          <input id="f-firstname" name="firstname" type="text" placeholder="Ton prénom" required />
        </div>
        <div class="field">
          <label class="mono" for="f-name">Nom</label>
          <input id="f-name" name="name" type="text" placeholder="Ton nom" required />
        </div>
        <div class="field">
          <label class="mono" for="f-email">E-mail</label>
          <input id="f-email" name="email" type="email" placeholder="toi@exemple.fr" required />
        </div>
        <div class="field">
          <label class="mono" for="f-interest">Je veux</label>
          <select id="f-interest" name="interest" required>
            <option value="" disabled selected>Choisir…</option>
            {univers.map((u) => <option data-slug={u.slug}>{u.cta}</option>)}
          </select>
        </div>
        <label class="consent">
          <input type="checkbox" name="rgpd" required />
          <span>J'accepte que mes données soient utilisées pour traiter ma demande (voir la <a href="/confidentialite" target="_blank">Politique de confidentialité</a>). *</span>
        </label>
        <button type="submit" class="btn btn--red">Envoyer ma demande <span class="arrow" aria-hidden="true">→</span></button>
        <p class="engager__feedback mono" data-engage-feedback role="status"></p>
      </form>
    </div>
  </section>
</Base>

<style>
  /* — Hero — */
  .hero { position: relative; min-height: 100svh; display: flex; align-items: center; padding-block: 6rem 2.5rem; }
  .hero__inner { width: 100%; }
  .hero__kicker { margin-bottom: 1rem; }
  .hero__logo { width: 100%; max-width: min(64vw, 880px); height: auto; margin-bottom: clamp(1.4rem, 3vw, 2.4rem); }
  .hero__bottom {
    display: grid; grid-template-columns: 1.05fr 0.95fr; gap: clamp(2rem, 5vw, 5rem);
    align-items: start; border-top: 1px solid var(--hairline); padding-top: clamp(1.4rem, 2.6vw, 2.2rem);
  }
  .hero__lead { font-size: var(--fs-lead); max-width: 40ch; color: #2a2a2e; line-height: 1.45; }
  .hero__lead strong { color: var(--ink); font-weight: 700; }
  .hero__cta { display: flex; gap: 1rem; margin-top: 2rem; flex-wrap: wrap; }

  /* photo du hero (remplace le sommaire) */
  .hero__media { position: relative; aspect-ratio: 4 / 5; border-radius: 16px; overflow: hidden; box-shadow: var(--shadow); }
  .hero__media-tag {
    position: absolute; left: 0.9rem; bottom: 0.9rem; z-index: 3;
    color: rgba(255,255,255,.85); background: rgba(10,10,11,.45); backdrop-filter: blur(3px);
    padding: 0.3rem 0.65rem; border-radius: 5px;
  }

  /* — Marquee — */
  .marquee { background: var(--ink); color: var(--white); padding-block: 1.1rem; overflow: hidden; border-block: 1px solid var(--ink); }
  .marquee__track { display: flex; width: max-content; animation: marquee 38s linear infinite; }
  .marquee__row { display: flex; }
  .marquee__item { font-family: var(--font-display); font-weight: 600; text-transform: uppercase; font-size: clamp(1.6rem, 4vw, 2.8rem); letter-spacing: -0.01em; display: inline-flex; align-items: center; padding-inline: 1.2rem; white-space: nowrap; }
  .marquee__star { color: var(--red-bright); margin-left: 2.4rem; font-size: 0.6em; }
  @keyframes marquee { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .marquee__track { animation: none; } }

  /* — Manifeste — */
  .manifesto__grid { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
  .manifesto__statement { font-size: clamp(2.2rem, 1.4rem + 4vw, 5rem); margin: 0.7rem 0 1.4rem; }
  .manifesto__statement .accent { color: var(--red); }
  .manifesto__copy { font-size: var(--fs-lead); color: #3a3a40; max-width: 46ch; line-height: 1.45; margin-bottom: clamp(1.6rem, 3vw, 2.4rem); }
  .manifesto__facts { display: grid; grid-template-columns: repeat(3, auto); gap: clamp(1.4rem, 3vw, 2.6rem); justify-content: start; border-top: 1px solid var(--hairline); padding-top: 1.4rem; }
  .manifesto__fact { display: grid; gap: 0.2rem; }
  .manifesto__fact b { font-size: clamp(1.3rem, 2.6vw, 1.9rem); line-height: 1; }
  .manifesto__fact .accent { color: var(--red); }
  .manifesto__media { aspect-ratio: 4 / 5; border-radius: 14px; overflow: hidden; box-shadow: var(--shadow); }

  /* — Bandeau émotion (pleine largeur, ample) — */
  .photoband { position: relative; height: clamp(440px, 74vh, 760px); overflow: hidden; }
  .photoband__media { position: absolute; inset: 0; }
  .photoband__overlay {
    position: absolute; inset: 0; z-index: 2; display: flex; flex-direction: column; justify-content: flex-end;
    padding-block: clamp(1.5rem, 5vw, 4rem); color: #fff;
    background: linear-gradient(to top, rgba(8,8,10,.74), rgba(8,8,10,.12) 55%, transparent);
  }
  .photoband__overlay .eyebrow { color: #fff; }
  .photoband__line { font-size: clamp(2.4rem, 7vw, 6rem); }
  .photoband__line .accent { color: var(--red-bright); }

  /* — Roster (dark) — */
  .roster__grid { margin-top: 1.5rem; }
  .roster__row { display: grid; grid-template-columns: 12rem 1fr; gap: 1.5rem; align-items: baseline; padding-block: clamp(1.4rem, 3vw, 2.4rem); border-top: 1px solid var(--hairline-d); }
  .roster__row:last-child { border-bottom: 1px solid var(--hairline-d); }
  .roster__k { color: var(--red-bright); }
  .roster__v { font-size: clamp(1.6rem, 4.5vw, 3.2rem); }

  /* — Partenaires — */
  .partners__viewport {
    overflow: hidden; margin-top: 1.6rem;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
  }
  .partners__track { display: flex; width: max-content; animation: partners 30s linear infinite; }
  .partners__viewport:hover .partners__track { animation-play-state: paused; }
  .partners__set { display: flex; align-items: center; }
  .partners__logo {
    flex: 0 0 auto; width: clamp(150px, 20vw, 210px); height: 96px; margin-inline: clamp(0.6rem, 1.4vw, 1.3rem);
    display: grid; place-items: center; background: var(--white);
    border: 1px solid var(--hairline); border-radius: 12px; color: var(--smoke);
    transition: border-color 0.3s var(--ease), color 0.3s var(--ease);
  }
  .partners__logo:hover { border-color: var(--red); color: var(--red); }
  @keyframes partners { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .partners__track { animation: none; } }

  /* — Engager — */
  .engager__grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .engager__head { display: flex; flex-direction: column; gap: clamp(1.4rem, 3vw, 2.2rem); }
  .engager__media { aspect-ratio: 16 / 10; border-radius: 14px; overflow: hidden; box-shadow: var(--shadow); }
  .engager__title { font-size: var(--fs-h2); margin: 0.8rem 0 1rem; }
  .engager__lead { font-size: var(--fs-lead); color: #4a4a50; max-width: 36ch; }
  .engager__alt { margin-top: 1rem; color: var(--smoke); text-transform: none; letter-spacing: 0.04em; }
  .engager__alt a { color: var(--red); }
  .engager__alt a:hover { text-decoration: underline; }
  .engager__form { display: grid; gap: 1rem; background: var(--ink); color: #fff; padding: clamp(1.5rem, 3vw, 2.4rem); border-radius: 16px; }
  .field { display: grid; gap: 0.4rem; }
  .field label { color: #8a8a90; }
  .field input, .field select {
    background: #15151a; border: 1px solid #2a2a31; border-radius: 9px; padding: 0.85rem 1rem; color: #fff;
  }
  .field input::placeholder { color: #6a6a72; }
  .field input:focus, .field select:focus { outline: 2px solid var(--red); border-color: var(--red); }
  .engager__form .btn { justify-content: center; margin-top: 0.4rem; }
  .engager__feedback { color: var(--red-bright); min-height: 1.2em; text-transform: none; letter-spacing: 0; }
  .engager__form .consent { display: flex; align-items: flex-start; gap: 0.6rem; font-size: 0.85rem; color: #b9b9c0; line-height: 1.4; cursor: pointer; }
  .engager__form .consent input { width: auto; margin-top: 0.2rem; accent-color: var(--red); flex-shrink: 0; }
  .engager__form .consent a { color: var(--red-bright); text-decoration: underline; }

  @media (max-width: 860px) {
    .hero__bottom { grid-template-columns: 1fr; align-items: start; }
    .hero__media { aspect-ratio: 16 / 10; }
    .manifesto__grid { grid-template-columns: 1fr; gap: 2rem; }
    .manifesto__media { aspect-ratio: 16 / 10; }
    .roster__row { grid-template-columns: 1fr; gap: 0.4rem; }
    .engager__grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    .manifesto__facts { grid-template-columns: 1fr; gap: 1rem; }
  }
</style>
