---
// Ancienne adresse du Club FFA, devenu Team Perf : on redirige (chemin
// relatif, quel que soit le domaine) pour ne casser ni les liens partagés ni
// le référencement.
const target = '/univers/team-perf/';
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <title>Team Perf · VELCAP</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(target, Astro.site).href} />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <script is:inline define:vars={{ target }}>location.replace(target);</script>
  </head>
  <body>
    <p><a href={target}>Team Perf</a></p>
  </body>
</html>
