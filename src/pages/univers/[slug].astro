---
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import { univers } from '../../data/univers.js';

export function getStaticPaths() {
  return univers.map((u, i) => ({
    params: { slug: u.slug },
    props: {
      u,
      prev: univers[(i - 1 + univers.length) % univers.length],
      next: univers[(i + 1) % univers.length],
    },
  }));
}

const { u, prev, next } = Astro.props;
const total = String(univers.length).padStart(2, '0');
const formHref = `/?u=${u.slug}#engager`;

// Formulaire sur-mesure par univers (Club FFC = pas de formulaire)
const FIELD = {
  firstname: { name: 'firstname', label: 'Prénom', type: 'text', required: true },
  name: { name: 'name', label: 'Nom', type: 'text', required: true },
  email: { name: 'email', label: 'E-mail', type: 'email', required: true },
  phone: { name: 'phone', label: 'Téléphone', type: 'tel' },
  message: { name: 'message', label: 'Message', type: 'textarea' },
};
const FORMS = {
  'team-loisirs': {
    title: 'Adhérer au Team Loisirs',
    fields: [FIELD.firstname, FIELD.name, FIELD.email, FIELD.phone,
      { name: 'tier', label: 'Formule', type: 'select', required: true,
        options: ['Adhésion Communauté · 180 €', 'Adhésion Performance · 250 €'] },
      FIELD.message],
  },
  'team-elite': {
    title: 'Candidater à la Team Élite',
    fields: [FIELD.firstname, FIELD.name, FIELD.email, FIELD.phone,
      { name: 'background', label: 'Parcours sportif', type: 'textarea', required: true },
      { name: 'motivation', label: 'Ta motivation', type: 'textarea', required: true },
      FIELD.message],
  },
  'club-ffa': {
    title: 'Licence et inscription · Club FFA',
    fields: [FIELD.firstname, FIELD.name, FIELD.email, FIELD.phone,
      { name: 'age', label: 'Âge', type: 'number' },
      { name: 'level', label: 'Niveau actuel', type: 'select',
        options: ['Débutant', 'Intermédiaire', 'Confirmé', 'Compétiteur'] },
      FIELD.message],
  },
  coaching: {
    title: 'Demander un coaching',
    fields: [FIELD.firstname, FIELD.name, FIELD.email, FIELD.phone,
      { name: 'discipline', label: 'Discipline', type: 'select', required: true,
        options: ['Course à pied', 'Trail', 'Route', 'Cross', 'Piste', 'Vélo'] },
      { name: 'tier', label: 'Formule', type: 'select',
        options: ['Basique', 'Médium', 'Premium'] },
      { name: 'goals', label: 'Tes objectifs', type: 'textarea' },
      FIELD.message],
  },
  evenements: {
    title: 'Nous envoyer une demande',
    fields: [FIELD.firstname, FIELD.name, FIELD.email,
      { name: 'eventtype', label: 'Type de demande', type: 'select', required: true,
        options: ['Participer à un événement', 'Proposer une intervention', 'Partenariat', 'Autre'] },
      FIELD.message],
  },
};
const form = FORMS[u.slug];

// Mini-galerie par univers (photos supplémentaires, N&B)
const GALLERY = {
  'team-loisirs': ['gal-team-loisirs-1.jpg', 'gal-team-loisirs-2.jpg', 'gal-team-loisirs-3.jpg'],
  'team-elite': ['gal-team-elite-1.jpg', 'gal-team-elite-2.jpg', 'gal-team-elite-3.jpg'],
  'club-ffa': ['gal-club-ffa-1.jpg', 'gal-club-ffa-2.jpg', 'gal-club-ffa-3.jpg'],
  coaching: ['gal-coaching-1.jpg', 'gal-coaching-2.jpg', 'gal-coaching-3.jpg'],
  evenements: ['gal-evenements-1.jpg', 'gal-evenements-2.jpg', 'gal-evenements-3.jpg'],
};
const gallery = GALLERY[u.slug];

// Recadrages sur-mesure (object-position / dézoom), sans déformer l'image.
// flat = pas de sur-zoom de parallaxe : on voit davantage du sujet (dézoom).
// Club FFA : hero remonté (visages) + dézoomé. Team Loisirs : hero dézoomé.
const HERO_FRAME = {
  'club-ffa': { pos: 'center 32%', flat: true },
  'team-loisirs': { flat: true },
};
// Team Élite : la 3e photo (droite) est dézoomée pour montrer les athlètes coupés.
const GAL_FRAME = { 'team-elite': { 2: { wide: true, flat: true, parallax: 0 } } };
const heroFrame = HERO_FRAME[u.slug] || {};
const galFrame = GAL_FRAME[u.slug] || {};
---
<Base title={`${u.name} · VELCAP`} description={u.intro}>
  <!-- HERO -->
  <section class="uhero" data-parallax-scope>
    <div class="container">
      <nav class="uhero__crumb mono" aria-label="Fil d'ariane" data-intro data-intro-order="0">
        <a href="/">VELCAP</a> <span>/</span> <a href="/#univers">Univers</a> <span>/</span>
        <span class="accent">{u.index}</span> <span>·</span> {total}
      </nav>

      <div class="uhero__top">
        <span class="uhero__index display" data-intro data-intro-order="1">{u.index}</span>
        <div class="uhero__titles">
          <p class="mono eyebrow" data-intro data-intro-order="2">{u.discipline}</p>
          <h1 class="uhero__name display" data-intro="clip" data-intro-order="2">{u.name}</h1>
          <p class="uhero__lead" data-intro data-intro-order="3">{u.lead}</p>
        </div>
      </div>
    </div>

    <div class="uhero__visual" data-intro data-intro-order="4">
      <Photo src={`univers-${u.slug}.jpg`} treatment="color" slug={u.slug} parallax={heroFrame.flat ? 0 : 8} flat={heroFrame.flat || false} alt={u.name} pos={heroFrame.pos || ''} />
    </div>
  </section>

  <!-- INTRO -->
  <section class="section udetail">
    <div class="container">
      <p class="udetail__intro" data-reveal>{u.intro}</p>
      {u.note && <p class="udetail__note mono" data-reveal data-delay="0.05">{u.note}</p>}
    </div>
  </section>

  {u.freeTrial && (
    <section class="section freetrial">
      <div class="container freetrial__inner" data-reveal>
        <div class="freetrial__copy">
          <p class="mono eyebrow">Gratuit · sans engagement</p>
          <p class="freetrial__title display">{u.freeTrial.title}</p>
          <p class="freetrial__text">{u.freeTrial.text}</p>
        </div>
        <a class="btn btn--red btn--lg freetrial__cta" href="/contact" data-magnetic>
          Réserver mon essai <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  )}

  {u.comingSoon && (
    <section class="section soon">
      <div class="container soon__inner" data-reveal>
        <p class="soon__tag mono">En préparation</p>
        <p class="soon__line display">Le projet<br />arrive <span class="accent">bientôt.</span></p>
        <a class="btn btn--red btn--lg" href={formHref} data-magnetic>{u.cta} <span class="arrow">→</span></a>
      </div>
    </section>
  )}

  {u.points && (
    <section class="section">
      <div class="container">
        <p class="mono eyebrow" data-reveal>Ce qu'on met en place</p>
        <div class="points" data-reveal-group>
          {u.points.map((p, i) => (
            <div class="point" data-reveal-item>
              <span class="point__n mono">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="point__k display">{p.k}</h3>
                <p class="point__v">{p.v}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {u.schedule && (
    <section class="section schedule">
      <div class="container schedule__grid">
        <div data-reveal>
          <p class="mono eyebrow">Créneaux</p>
          <ul class="schedule__list">
            {u.schedule.map((s) => <li class="display">{s}</li>)}
          </ul>
        </div>
        {u.price && (
          <div class="schedule__price" data-reveal data-delay="0.1">
            <p class="mono">Tarif</p>
            <span class="schedule__q display">{u.price}</span>
            <p class="schedule__note mono">à confirmer</p>
          </div>
        )}
      </div>
    </section>
  )}

  {u.tiers && (
    <section class="section tiers">
      <div class="container">
        <p class="mono eyebrow" data-reveal>{u.tiers.length === 2 ? 'Deux adhésions' : 'Trois formules'}</p>
        <div class={`tiers__grid tiers__grid--${u.tiers.length}`} data-reveal-group>
          {u.tiers.map((t) => (
            <article class={`tier ${t.highlight ? 'tier--hl' : ''}`} data-reveal-item>
              {t.highlight && <span class="tier__badge mono">Le + complet</span>}
              <h3 class="tier__name display">{t.name}</h3>
              {t.price ? <p class="tier__price display">{t.price}</p>
                       : <p class="tier__price tier__price--soft mono">Sur devis</p>}
              {t.tagline && <p class="tier__tagline">{t.tagline}</p>}
              {t.features && t.features.length > 0 ? (
                <ul class="tier__features">
                  {t.features.map((f) => <li>{f}</li>)}
                </ul>
              ) : (
                <p class="tier__soon mono">Détails à venir</p>
              )}
              <button type="button" class="btn btn--dark tier__cta" data-open-form data-tier={t.name} data-magnetic>{u.cta} <span class="arrow">→</span></button>
            </article>
          ))}
        </div>
        {u.tiersNote && <p class="tiers__note mono" data-reveal>{u.tiersNote}</p>}
      </div>
    </section>
  )}

  {u.criteria && (
    <section class="section criteria">
      <div class="container criteria__grid">
        <div data-reveal>
          <p class="mono eyebrow">Critères de sélection</p>
          <ul class="criteria__list">
            {u.criteria.map((c, i) => (
              <li><span class="mono">{String(i + 1).padStart(2, '0')}</span> <span class="display">{c}</span></li>
            ))}
          </ul>
        </div>
        {u.aside && (
          <aside class="callout" data-reveal data-delay="0.1">
            <p class="mono eyebrow">{u.aside.title}</p>
            <p class="callout__text">{u.aside.text}</p>
          </aside>
        )}
      </div>
    </section>
  )}

  {u.events && (
    <section class="section events">
      <div class="container">
        <p class="mono eyebrow" data-reveal>Le calendrier</p>
        <ol class="events__list" data-reveal-group>
          {u.events.map((e, i) => (
            <li class="event" data-reveal-item>
              <span class="event__n mono">{String(i + 1).padStart(2, '0')}</span>
              <span class="event__name display">{e}</span>
              <span class="event__line" aria-hidden="true"></span>
            </li>
          ))}
        </ol>
        {u.request && <p class="events__request" data-reveal>{u.request}</p>}
      </div>
    </section>
  )}

  {!u.comingSoon && !u.tiers && (
    <section class="ucta section--dark">
      <div class="container ucta__inner">
        <p class="mono eyebrow" data-reveal>Passer à l'action</p>
        <p class="ucta__line display" data-reveal data-delay="0.05">Rejoins <span class="accent">{u.name}.</span></p>
        <button type="button" class="btn btn--red btn--lg" data-open-form data-magnetic>{u.cta} <span class="arrow">→</span></button>
      </div>
    </section>
  )}

  {u.coaches && (
    <section class="section coaches">
      <div class="container">
        <div class="coaches__head" data-reveal>
          <p class="mono eyebrow">L'encadrement</p>
          <h2 class="coaches__title display">Les coachs</h2>
          <p class="coaches__note mono">Cartes d'exemple, prêtes à recevoir les vrais profils.</p>
        </div>
        <div class="coaches__grid" data-reveal-group>
          {u.coaches.map((c, i) => (
            <article class="coach" data-reveal-item>
              <div class="coach__photo">
                <Photo src={`coach-${u.slug}-${i + 1}.jpg`} treatment="bw" slug={u.slug} alt={c.name} hint={false} />
              </div>
              <div class="coach__body">
                <p class="coach__role mono">{c.role}</p>
                <h3 class="coach__name display">{c.name}</h3>
                <p class="coach__line">{c.line}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {gallery && (
    <section class="section ugallery">
      <div class="container">
        <p class="mono eyebrow" data-reveal>En images</p>
        <div class="ugallery__grid" data-reveal-group>
          {gallery.map((src, i) => {
            const gf = galFrame[i] || {};
            return (
              <div class={`ugallery__item ugallery__item--${i} ${gf.wide ? 'ugallery__item--wide' : ''}`} data-reveal-item data-parallax-scope>
                <Photo src={src} treatment="bw" slug={u.slug} parallax={gf.parallax ?? 6} flat={gf.flat || false} alt={`${u.name}, photo ${i + 1}`} />
              </div>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- PREV / NEXT -->
  <nav class="unav" aria-label="Autres univers">
    <a class="unav__link unav__link--prev" href={`/univers/${prev.slug}`}>
      <span class="mono">← {prev.index} Précédent</span>
      <span class="unav__name display">{prev.name}</span>
    </a>
    <a class="unav__link unav__link--next" href={`/univers/${next.slug}`}>
      <span class="mono">Suivant {next.index} →</span>
      <span class="unav__name display">{next.name}</span>
    </a>
  </nav>

  {form && (
    <div class="umodal" data-univers-modal aria-hidden="true">
      <div class="umodal__backdrop" data-modal-close></div>
      <div class="umodal__panel" role="dialog" aria-modal="true" aria-label={form.title}>
        <button type="button" class="umodal__x" data-modal-close aria-label="Fermer">✕</button>
        <p class="mono eyebrow">{u.name}</p>
        <h2 class="umodal__title display">{form.title}</h2>
        <form class="umodal__form" data-univers-form novalidate>
          {form.fields.map((f) => (
            <div class={`field ${f.type === 'textarea' ? 'field--full' : ''}`}>
              <label class="mono" for={`m-${f.name}`}>{f.label}{f.required ? ' *' : ''}</label>
              {f.type === 'textarea' ? (
                <textarea id={`m-${f.name}`} name={f.name} rows="3" required={f.required}></textarea>
              ) : f.type === 'select' ? (
                <select id={`m-${f.name}`} name={f.name} required={f.required}>
                  <option value="" disabled selected>Choisir…</option>
                  {f.options.map((o) => <option>{o}</option>)}
                </select>
              ) : (
                <input id={`m-${f.name}`} name={f.name} type={f.type} required={f.required} />
              )}
            </div>
          ))}

          {u.slug === 'club-ffa' && (
            <label class="consent field--full">
              <input type="checkbox" name="minor_auth" />
              <span>Pour l'adhésion d'un·e mineur·e, je suis le représentant légal et fournirai l'autorisation parentale.</span>
            </label>
          )}
          {u.slug !== 'evenements' && (
            <label class="consent field--full">
              <input type="checkbox" name="medical" required />
              <span>Je m'engage à fournir un certificat médical de non contre-indication à la pratique sportive. *</span>
            </label>
          )}
          <label class="consent field--full">
            <input type="checkbox" name="rgpd" required />
            <span>J'accepte que mes données soient utilisées pour traiter ma demande, conformément à la <a href="/confidentialite" target="_blank">Politique de confidentialité</a>. *</span>
          </label>
          {u.slug !== 'evenements' && (
            <label class="consent field--full">
              <input type="checkbox" name="image" />
              <span>J'autorise VELCAP à utiliser mon image (photos / vidéos) dans le cadre de sa communication. (facultatif)</span>
            </label>
          )}

          <button type="submit" class="btn btn--red umodal__submit">Envoyer ma demande <span class="arrow">→</span></button>
          <p class="umodal__feedback mono" data-univers-feedback role="status"></p>
        </form>
      </div>
    </div>
  )}
</Base>

<style>
  .uhero { padding-block: clamp(6.5rem, 11vw, 10rem) 0; }
  .uhero__crumb { display: flex; gap: 0.5rem; align-items: center; margin-bottom: clamp(1.6rem, 4vw, 3rem); flex-wrap: wrap; }
  .uhero__crumb a:hover { color: var(--ink); }
  .uhero__crumb .accent { color: var(--red); }
  .uhero__top { display: grid; grid-template-columns: auto 1fr; gap: clamp(1rem, 4vw, 3rem); align-items: start; }
  .uhero__index { font-size: clamp(4rem, 15vw, 12rem); line-height: 0.8; color: var(--red); }
  .uhero__name { font-size: var(--fs-h2); margin: 0.4rem 0 0.9rem; }
  .uhero__lead { font-size: var(--fs-lead); color: #3a3a40; max-width: 30ch; }
  /* hero pleine largeur (full-bleed, bord à bord) */
  .uhero__visual { margin-top: clamp(2rem, 5vw, 4rem); width: 100%; height: clamp(340px, 62vh, 720px); }
  .uhero__visual :global(.ph) { height: 100%; }

  .udetail { padding-block: clamp(2.5rem, 5vw, 4rem); }
  .udetail__intro { font-size: clamp(1.25rem, 1rem + 1vw, 1.7rem); line-height: 1.45; color: var(--ink); font-family: var(--font-body); font-weight: 500; max-width: 60ch; }
  .udetail__note { margin-top: 1.2rem; color: var(--smoke); max-width: 60ch; letter-spacing: 0.06em; }

  /* — Essai gratuit — */
  .freetrial { padding-block: clamp(1rem, 2vw, 1.5rem); }
  .freetrial__inner {
    display: flex; align-items: center; justify-content: space-between; gap: clamp(1.4rem, 3vw, 2.5rem);
    flex-wrap: wrap; background: var(--white); border: 1px solid var(--hairline); border-left: 5px solid var(--red);
    border-radius: 16px; padding: clamp(1.5rem, 3vw, 2.4rem); box-shadow: var(--shadow);
  }
  .freetrial__copy .eyebrow { color: var(--red); }
  .freetrial__title { font-size: clamp(1.6rem, 4vw, 2.6rem); margin: 0.5rem 0 0.5rem; }
  .freetrial__text { color: #4a4a50; max-width: 52ch; }
  .freetrial__cta { flex-shrink: 0; }

  /* — Coachs — */
  .coaches__head { margin-bottom: clamp(1.4rem, 3vw, 2rem); }
  .coaches__title { font-size: var(--fs-h3); margin: 0.4rem 0 0.4rem; }
  .coaches__note { color: var(--smoke); text-transform: none; letter-spacing: 0.04em; }
  .coaches__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1rem, 2vw, 1.6rem); }
  .coach { background: var(--white); border: 1px solid var(--hairline); border-radius: 16px; overflow: hidden; box-shadow: var(--shadow); transition: transform 0.4s var(--ease), box-shadow 0.4s var(--ease); }
  .coach:hover { transform: translateY(-4px); }
  .coach__photo { position: relative; aspect-ratio: 4 / 5; }
  .coach__body { padding: 1.1rem 1.2rem 1.4rem; }
  .coach__role { color: var(--red); }
  .coach__name { font-size: clamp(1.3rem, 2.4vw, 1.85rem); margin: 0.3rem 0 0.45rem; }
  .coach__line { color: #4a4a50; font-size: 0.96rem; }

  .points { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0; }
  .point { display: grid; grid-template-columns: 3rem 1fr; gap: 1rem; padding: clamp(1.2rem, 2.5vw, 1.8rem) 1.5rem clamp(1.2rem, 2.5vw, 1.8rem) 0; border-top: 1px solid var(--hairline); }
  .point__n { color: var(--red); padding-top: 0.35rem; }
  .point__k { font-size: var(--fs-h3); margin-bottom: 0.3rem; }
  .point__v { color: #4a4a50; }

  .schedule__grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 2rem; align-items: center; border-top: 1px solid var(--hairline); padding-top: clamp(1.5rem, 3vw, 2.5rem); }
  .schedule__list { display: grid; gap: 0.6rem; margin-top: 1rem; }
  .schedule__list li { font-size: clamp(1.4rem, 3vw, 2.2rem); }
  .schedule__price { justify-self: end; text-align: right; }
  .schedule__q { font-size: clamp(3rem, 8vw, 6rem); color: var(--red); line-height: 1; }
  .schedule__note { margin-top: 0.3rem; }

  .tiers__grid { display: grid; gap: clamp(1rem, 2vw, 1.5rem); margin-top: 1.5rem; }
  .tiers__grid--2 { grid-template-columns: repeat(2, 1fr); }
  .tiers__grid--3 { grid-template-columns: repeat(3, 1fr); }
  .tier {
    position: relative; display: flex; flex-direction: column; gap: 0.7rem;
    background: var(--white); border: 1px solid var(--hairline); border-radius: 16px;
    padding: clamp(1.4rem, 2.5vw, 2rem);
  }
  .tier--hl { border-color: var(--ink); box-shadow: var(--shadow); }
  .tier__badge { position: absolute; top: -0.7rem; left: 1.4rem; background: var(--red); color: #fff; padding: 0.25rem 0.7rem; border-radius: 999px; }
  .tier__name { font-size: clamp(1.5rem, 3vw, 2rem); }
  .tier__price { font-size: clamp(2rem, 4vw, 3rem); color: var(--red); line-height: 1; }
  .tier__price--soft { color: var(--smoke); font-size: 0.9rem; }
  .tier__tagline { color: #4a4a50; }
  .tier__features { display: grid; gap: 0.5rem; margin: 0.4rem 0 1rem; }
  .tier__features li { position: relative; padding-left: 1.4rem; color: #2a2a2e; font-size: 0.98rem; }
  .tier__features li::before { content: ""; position: absolute; left: 0; top: 0.55em; width: 8px; height: 8px; background: var(--red); clip-path: polygon(0 0, 100% 50%, 0 100%); }
  .tier__soon { color: var(--smoke); margin: 0.6rem 0 1rem; }
  .tier__cta { margin-top: auto; justify-content: center; }
  .tiers__note { margin-top: 1.4rem; color: var(--smoke); }

  .criteria__grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .criteria__list { display: grid; gap: 0.2rem; margin-top: 1rem; }
  .criteria__list li { display: grid; grid-template-columns: 2.5rem 1fr; align-items: center; gap: 1rem; padding: clamp(0.7rem, 1.6vw, 1.1rem) 0; border-top: 1px solid var(--hairline); }
  .criteria__list .mono { color: var(--red); }
  .criteria__list .display { font-size: clamp(1.2rem, 2.4vw, 1.8rem); }
  .callout { background: var(--ink); color: #fff; border-radius: 16px; padding: clamp(1.5rem, 3vw, 2.2rem); }
  .callout .eyebrow { color: var(--red-bright); margin-bottom: 0.8rem; }
  .callout__text { color: #c8c8cf; }

  .events__list { margin-top: 1.5rem; }
