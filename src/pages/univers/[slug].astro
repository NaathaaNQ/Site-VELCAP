---
import Base from '../../layouts/Base.astro';
import Visual from '../../components/Visual.astro';
import { univers } from '../../data/univers.js';

export function getStaticPaths() {
  return univers.map((u, i) => ({
    params: { slug: u.slug },
    props: {
      u,
      prev: univers[(i - 1 + univers.length) % univers.length],
      next: univers[(i + 1) % univers.length],
    },
  }));
}

const { u, prev, next } = Astro.props;
---
<Base title={`${u.name} — VELCAP`} description={u.intro}>
  <!-- HERO -->
  <section class="uhero" data-parallax-scope>
    <div class="container">
      <nav class="uhero__crumb mono" aria-label="Fil d'ariane" data-intro data-intro-order="0">
        <a href="/">VELCAP</a> <span>/</span> <a href="/#univers">Univers</a> <span>/</span> <span class="accent">{u.index}</span>
      </nav>

      <div class="uhero__top">
        <span class="uhero__index display" data-intro data-intro-order="1">{u.index}</span>
        <div class="uhero__titles">
          <p class="mono eyebrow" data-intro data-intro-order="2">{u.discipline}</p>
          <h1 class="uhero__name display" data-intro="clip" data-intro-order="2">{u.name}</h1>
          <p class="uhero__lead" data-intro data-intro-order="3">{u.lead}</p>
        </div>
      </div>
    </div>

    <div class="container uhero__visual" data-intro data-intro-order="4">
      <Visual slug={u.slug} tone="red" label={`VELCAP / ${u.index} — ${u.discipline}`} />
    </div>
  </section>

  <!-- INTRO + POINTS -->
  <section class="section udetail">
    <div class="container udetail__grid">
      <p class="udetail__intro" data-reveal>{u.intro}</p>

      <div class="udetail__points" data-reveal-group>
        {u.points.map((p, i) => (
          <div class="point" data-reveal-item>
            <span class="point__n mono">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="point__k display">{p.k}</h3>
              <p class="point__v">{p.v}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- STAT BAND -->
  <section class="ustat section--dark">
    <div class="container ustat__inner">
      <span class="ustat__n display">{u.stat.n}</span>
      <p class="ustat__label">{u.stat.label}</p>
      <a class="btn btn--red ustat__cta" href="/#engager">{u.cta} <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </section>

  <!-- PREV / NEXT -->
  <nav class="unav" aria-label="Autres univers">
    <a class="unav__link unav__link--prev" href={`/univers/${prev.slug}`}>
      <span class="mono">← {prev.index} Précédent</span>
      <span class="unav__name display">{prev.name}</span>
    </a>
    <a class="unav__link unav__link--next" href={`/univers/${next.slug}`}>
      <span class="mono">Suivant {next.index} →</span>
      <span class="unav__name display">{next.name}</span>
    </a>
  </nav>
</Base>

<style>
  .uhero { padding-block: clamp(7rem, 12vw, 11rem) 0; }
  .uhero__crumb { display: flex; gap: 0.6rem; align-items: center; margin-bottom: clamp(2rem, 5vw, 4rem); }
  .uhero__crumb a:hover { color: var(--ink); }
  .uhero__crumb .accent { color: var(--red); }
  .uhero__top { display: grid; grid-template-columns: auto 1fr; gap: clamp(1rem, 4vw, 3rem); align-items: start; }
  .uhero__index { font-size: clamp(4rem, 16vw, 13rem); line-height: 0.8; color: var(--red); }
  .uhero__name { font-size: var(--fs-h2); margin: 0.5rem 0 1rem; }
  .uhero__lead { font-size: var(--fs-lead); color: #3a3a40; max-width: 30ch; }
  .uhero__visual { margin-top: clamp(2.5rem, 6vw, 5rem); }
  .uhero__visual :global(.visual) { aspect-ratio: 21 / 9; border-radius: 16px; overflow: hidden; }

  .udetail__grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(2rem, 6vw, 5rem); align-items: start; }
  .udetail__intro { font-size: clamp(1.3rem, 1rem + 1.4vw, 2rem); line-height: 1.4; color: var(--ink); font-family: var(--font-display); font-weight: 500; }
  .udetail__points { display: grid; gap: 0.4rem; }
  .point { display: grid; grid-template-columns: 3rem 1fr; gap: 1rem; padding-block: 1.4rem; border-top: 1px solid var(--hairline); }
  .point__n { color: var(--red); padding-top: 0.4rem; }
  .point__k { font-size: var(--fs-h3); margin-bottom: 0.3rem; }
  .point__v { color: #4a4a50; }

  .ustat { background: var(--ink); color: #fff; padding-block: clamp(3.5rem, 8vw, 7rem); }
  .ustat__inner { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 0.6rem; }
  .ustat__n { font-size: clamp(5rem, 18vw, 14rem); line-height: 0.85; color: #fff; }
  .ustat__label { color: #9a9aa0; font-size: var(--fs-lead); max-width: 24ch; }
  .ustat__cta { margin-top: 1.6rem; }

  .unav { display: grid; grid-template-columns: 1fr 1fr; }
  .unav__link { padding: clamp(2rem, 5vw, 3.5rem) var(--gutter); display: grid; gap: 0.6rem; transition: background 0.3s var(--ease), color 0.3s var(--ease); }
  .unav__link--prev { border-right: 1px solid var(--hairline); }
  .unav__link--next { text-align: right; }
  .unav__name { font-size: clamp(1.6rem, 4vw, 2.6rem); }
  .unav__link:hover { background: var(--ink); color: #fff; }
  .unav__link:hover .mono { color: var(--red-bright); }

  @media (max-width: 760px) {
    .uhero__top { grid-template-columns: 1fr; }
    .udetail__grid { grid-template-columns: 1fr; }
    .unav { grid-template-columns: 1fr; }
    .unav__link--next { text-align: left; }
    .unav__link--prev { border-right: 0; border-bottom: 1px solid var(--hairline); }
  }
</style>
