---
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import WaitlistForm from '../../components/WaitlistForm.astro';
import { univers } from '../../data/univers.js';
import { site } from '../../data/site.js';

export function getStaticPaths() {
  return univers.map((u, i) => ({
    params: { slug: u.slug },
    props: {
      u,
      prev: univers[(i - 1 + univers.length) % univers.length],
      next: univers[(i + 1) % univers.length],
    },
  }));
}

const { u, prev, next } = Astro.props;
const total = String(univers.length).padStart(2, '0');

// Formulaire sur-mesure par univers (Club FFC = pas de formulaire)
const FIELD = {
  firstname: { name: 'firstname', label: 'Prénom', type: 'text', required: true },
  name: { name: 'name', label: 'Nom', type: 'text', required: true },
  email: { name: 'email', label: 'E-mail', type: 'email', required: true },
  phone: { name: 'phone', label: 'Téléphone', type: 'tel' },
  message: { name: 'message', label: 'Message', type: 'textarea' },
};
const FORMS = {
  'team-loisirs': {
    title: 'Adhérer au Team Loisirs',
    fields: [FIELD.firstname, FIELD.name, FIELD.email, FIELD.phone,
      { name: 'tier', label: 'Formule', type: 'select', required: true,
        options: ['Adhésion Communauté · 180 € / an', 'Adhésion Communauté Plus · 220 € / an'] },
      FIELD.message],
  },
  'team-elite': {
    title: 'Candidater à la Team Élite',
    fields: [FIELD.firstname, FIELD.name, FIELD.email, FIELD.phone,
      { name: 'background', label: 'Parcours sportif', type: 'textarea', required: true },
      { name: 'motivation', label: 'Ta motivation', type: 'textarea', required: true },
      FIELD.message],
  },
  'club-ffa': {
    title: 'Licence et inscription · Club FFA',
    fields: [FIELD.firstname, FIELD.name, FIELD.email, FIELD.phone,
      { name: 'age', label: 'Âge', type: 'number' },
      { name: 'level', label: 'Niveau actuel', type: 'select',
        options: ['Intermédiaire', 'Confirmé', 'Compétiteur'] },
      FIELD.message],
  },
  coaching: {
    title: 'Demander un coaching',
    fields: [FIELD.firstname, FIELD.name, FIELD.email, FIELD.phone,
      { name: 'discipline', label: 'Discipline', type: 'select', required: true,
        options: ['Course à pied', 'Trail', 'Route', 'Cross', 'Piste', 'Vélo'] },
      { name: 'tier', label: 'Formule', type: 'select',
        options: ['Suivi Découverte', 'Suivi Performance', 'Suivi Premium'] },
      { name: 'goals', label: 'Tes objectifs', type: 'textarea' },
      FIELD.message],
  },
  evenements: {
    title: 'Nous envoyer une demande',
    fields: [FIELD.firstname, FIELD.name, FIELD.email,
      { name: 'eventtype', label: 'Type de demande', type: 'select', required: true,
        options: ['Participer à un événement', 'Créer un événement', 'Proposer une intervention', 'Partenariat', 'Autre'] },
      FIELD.message],
  },
};
const form = FORMS[u.slug];

// Mini-galerie par univers (photos supplémentaires, N&B)
const GALLERY = {
  'team-loisirs': ['gal-team-loisirs-1.jpg', 'gal-team-loisirs-2.jpg', 'gal-team-loisirs-3.jpg'],
  'team-elite': ['gal-team-elite-1.jpg', 'gal-team-elite-2.jpg', 'gal-team-elite-3.jpg'],
  'club-ffa': ['gal-club-ffa-1.jpg', 'gal-club-ffa-2.jpg', 'gal-club-ffa-3.jpg'],
  coaching: ['gal-coaching-1.jpg', 'gal-coaching-2.jpg', 'gal-coaching-3.jpg'],
  evenements: ['gal-evenements-1.jpg', 'gal-evenements-2.jpg', 'gal-evenements-3.jpg'],
};
const gallery = GALLERY[u.slug];

// Recadrages sur-mesure (object-position / dézoom), sans déformer l'image.
// flat = pas de sur-zoom de parallaxe : on voit davantage du sujet (dézoom).
// Club FFA : hero remonté (visages) + dézoomé. Team Loisirs : hero dézoomé.
const HERO_FRAME = {
  // photo portrait dans un bandeau large : on dézoome en agrandissant le bandeau
  // (on révèle plus de la scène) et on remonte le cadrage sur les visages.
  'club-ffa': { pos: 'center 38%', flat: true, h: 'clamp(460px, 88vh, 940px)' },
  'team-loisirs': { flat: true },
};
// Team Élite : la 3e photo (droite) est dézoomée pour montrer les athlètes coupés.
const GAL_FRAME = { 'team-elite': { 2: { wide: true, flat: true, parallax: 0 } } };
const heroFrame = HERO_FRAME[u.slug] || {};
const galFrame = GAL_FRAME[u.slug] || {};

// Icônes fines (line, courant) pour la section « Sport en entreprise ».
const SE_ICON = {
  pulse: '<path d="M22 12h-4l-3 9L9 3l-3 9H2"/>',
  moon: '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>',
  bolt: '<path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/>',
  team: '<circle cx="9" cy="7" r="3.2"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/><path d="M16 4.2a3.2 3.2 0 0 1 0 6.1"/><path d="M17.5 14.4A6.5 6.5 0 0 1 21.5 20"/>',
  down: '<path d="M22 17 13.5 8.5l-4 4L2 5"/><path d="M16 17h6v-6"/>',
  chart: '<path d="M22 7 13.5 15.5l-4-4L2 19"/><path d="M16 7h6v6"/>',
  badge: '<circle cx="12" cy="8" r="5.2"/><path d="M8.7 12.4 7.5 21l4.5-2.7L16.5 21l-1.2-8.6"/>',
};
const se = u.sportEntreprise;
---
<Base title={`${u.name} · VELCAP`} description={u.intro}>
  <!-- HERO -->
  <section class="uhero" data-parallax-scope>
    <div class="container">
      <nav class="uhero__crumb mono" aria-label="Fil d'ariane" data-intro data-intro-order="0">
        <a href="/">VELCAP</a> <span>/</span> <a href="/#univers">Univers</a> <span>/</span>
        <span class="accent">{u.index}</span> <span>·</span> {total}
      </nav>

      <div class="uhero__top">
        <span class="uhero__index display" data-intro data-intro-order="1">{u.index}</span>
        <div class="uhero__titles">
          <p class="mono eyebrow" data-intro data-intro-order="2">{u.discipline}</p>
          <h1 class="uhero__name display" data-intro="clip" data-intro-order="2">{u.name}</h1>
          <p class="uhero__lead" data-intro data-intro-order="3">{u.lead}</p>
        </div>
      </div>
    </div>

    <div class="uhero__visual" data-intro data-intro-order="4" style={heroFrame.h ? `height:${heroFrame.h}` : undefined}>
      <Photo src={`univers-${u.slug}.jpg`} treatment="color" slug={u.slug} parallax={heroFrame.flat ? 0 : 8} flat={heroFrame.flat || false} alt={u.name} pos={heroFrame.pos || ''} />
    </div>
  </section>

  <!-- INTRO -->
  <section class="section udetail">
    <div class="container">
      <p class={`udetail__intro ${u.slug === 'team-loisirs' ? 'udetail__intro--justify' : ''}`} data-reveal>{u.intro}</p>
      {u.note && <p class="udetail__note mono" data-reveal data-delay="0.05">{u.note}</p>}
    </div>
  </section>

  {u.freeTrial && (
    <section class="section freetrial">
      <div class="container freetrial__inner" data-reveal>
        <div class="freetrial__copy">
          <p class="mono eyebrow">Gratuit · sans engagement</p>
          <p class="freetrial__title display">{u.freeTrial.title}</p>
          <p class="freetrial__text">{u.freeTrial.text}</p>
        </div>
        <a class="btn btn--red btn--lg freetrial__cta" href="/contact" data-magnetic>
          Réserver mon essai <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  )}

  {u.comingSoon && (
    <section class="section soon">
      <div class="container soon__inner" data-reveal>
        <p class="soon__tag mono">En préparation</p>
        <p class="soon__line display">Le projet<br />arrive <span class="accent">bientôt.</span></p>
        <p class="soon__text">Laisse-nous tes coordonnées : on te préviendra par e-mail dès l'ouverture du {u.name}.</p>
        <WaitlistForm
          narrow
          big
          idPrefix="ffc"
          ctaLabel={u.cta}
          eventName={u.name}
          subject={`Liste d'attente ${u.name} - site VELCAP`}
          context={`au lancement du ${u.name}`}
          success="Merci {firstname}, tu es sur la liste. On te prévient dès l'ouverture."
        />
      </div>
    </section>
  )}

  {u.points && (
    <section class="section">
      <div class="container">
        <p class="mono eyebrow" data-reveal>Ce qu'on met en place</p>
        <div class="points" data-reveal-group>
          {u.points.map((p, i) => (
            <div class="point" data-reveal-item>
              <span class="point__n mono">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="point__k display">{p.k}</h3>
                <p class="point__v">{p.v}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {u.schedule && (
    <section class="section schedule">
      <div class="container">
        <div class="schedule__grid">
          <div class="schedule__col" data-reveal>
            <p class="mono eyebrow">Créneaux</p>
            <ul class="schedule__list">
              {u.schedule.map((s) => <li class="display">{s}</li>)}
            </ul>
          </div>
          {u.places && (
            <div class="schedule__col schedule__loc" data-reveal data-delay="0.05">
              <p class="mono eyebrow">Lieux d'entraînement</p>
              <p class="schedule__places-text">{u.places}</p>
              {u.placesNote && <p class="schedule__places-note mono">{u.placesNote}</p>}
            </div>
          )}
        </div>
        {u.price && (
          <div class="schedule__tarif" data-reveal data-delay="0.1">
            <p class="mono">Tarif</p>
            <span class="schedule__q display">{u.price}</span>
            {u.priceNote && <p class="schedule__note mono">{u.priceNote}</p>}
          </div>
        )}
      </div>
    </section>
  )}

  {u.tiers && (
    <section class="section tiers">
      <div class="container">
        <p class="mono eyebrow" data-reveal>{u.tiers.length === 2 ? 'Deux adhésions' : 'Trois formules'}</p>
        <div class={`tiers__grid tiers__grid--${u.tiers.length}`} data-reveal-group>
          {u.tiers.map((t) => (
            <article class={`tier ${t.highlight ? 'tier--hl' : ''}`} data-reveal-item>
              {t.highlight && <span class="tier__badge mono">Le + complet</span>}
              <h3 class="tier__name display">{t.name}</h3>
              {t.price ? (
                <p class="tier__price display">{t.price}{t.per && <span class="tier__per mono">{t.per}</span>}{t.asterisk && <span class="tier__ast" aria-hidden="true">*</span>}</p>
              ) : (
                <p class="tier__price tier__price--soft mono">Sur devis</p>
              )}
              {t.sub && <p class="tier__sub mono">{t.sub}</p>}
              {t.shortPrice && <p class="tier__short">Prépa de moins de 6 mois : <strong>{t.shortPrice}/mois</strong></p>}
              {t.tagline && <p class="tier__tagline">{t.tagline}</p>}
              {t.features && t.features.length > 0 ? (
                <ul class="tier__features">
                  {t.features.map((f) => (
                    typeof f === 'string' ? (
                      <li>{f}</li>
                    ) : (
                      <li class="tier__feat--rich">
                        <details class="feat-acc">
                          <summary class="feat-acc__sum">{f.text}</summary>
                          {f.detailsLead && <p class="feat-acc__lead">{f.detailsLead}</p>}
                          <ul class="feat-acc__list">
                            {f.details.map((d) => <li>{d}</li>)}
                          </ul>
                        </details>
                      </li>
                    )
                  ))}
                </ul>
              ) : (
                <p class="tier__soon mono">Détails à venir</p>
              )}
              <button type="button" class="btn btn--dark tier__cta" data-open-form data-tier={t.name} data-magnetic>{u.cta} <span class="arrow">→</span></button>
            </article>
          ))}
        </div>
        {u.engagement && (
          <div class="engage-cond" data-reveal>
            <p class="engage-cond__title mono">{u.engagement.title}</p>
            <ul class="engage-cond__list">
              {u.engagement.items.map((it) => <li>{it}</li>)}
            </ul>
          </div>
        )}
        {u.tiersNote && (
          <p class="tiers__note" data-reveal>
            <span class="tiers__note-star" aria-hidden="true">*</span>
            <span>{u.tiersNote.replace(/^\*\s*/, '')}</span>
          </p>
        )}
      </div>
    </section>
  )}

  {u.enterprise && (
    <section class="section entreprise">
      <div class="container entreprise__inner" data-reveal>
        <div class="entreprise__copy">
          <p class="mono eyebrow">Aussi pour les entreprises</p>
          <p class="entreprise__title display">{u.enterprise.title}</p>
          <p class="entreprise__text">{u.enterprise.text}</p>
        </div>
        <div class="entreprise__price">
          <span class="entreprise__amount display">{u.enterprise.price}</span>
          <span class="entreprise__per mono">{u.enterprise.per}</span>
        </div>
      </div>
    </section>
  )}

  {se && (
    <section class="section se" id="sport-entreprise">
      <div class="container">
        <div class="se__head" data-reveal>
          <div class="se__headline">
            <p class="mono eyebrow">{se.eyebrow}</p>
            <h2 class="se__title display">{se.title}</h2>
          </div>
          {se.intro && <p class="se__intro">{se.intro}</p>}
        </div>

        <div class="se__panels">
          <!-- Volet 1 : bénéfices (clair, orienté humain) -->
          <div class="se-ben" data-reveal>
            <p class="se-ben__tag mono"><span aria-hidden="true">01</span> Les bénéfices</p>
            <div class="se-ben__cols">
              {se.benefits.map((b, gi) => (
                <div class={`se-aud ${gi === 1 ? 'se-aud--alt' : ''}`}>
                  <h3 class="se-aud__title display">{b.audience}</h3>
                  <ul class="se-aud__list" data-reveal-group>
                    {b.items.map((it) => (
                      <li class="se-item" data-reveal-item>
                        <span class="se-item__ic">
                          <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={SE_ICON[it.icon]} />
                        </span>
                        <span class="se-item__txt">{it.text}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>

          <!-- Volet 2 : avantages fiscaux (sombre, orienté chiffres) -->
          <aside class="se-fisc" data-reveal data-delay="0.08">
            <p class="se-fisc__tag mono"><span aria-hidden="true">02</span> Avantages fiscaux</p>
            <div class="se-fisc__figure">
              <span class="se-fisc__amount display">{se.fiscal.figure}</span>
              <span class="se-fisc__unit mono">{se.fiscal.figureLabel}</span>
            </div>
            <p class="se-fisc__lead">{se.fiscal.lead}</p>
            <ul class="se-fisc__cond">
              {se.fiscal.conditions.map((c) => <li>{c}</li>)}
            </ul>
            <p class="se-fisc__example">{se.fiscal.example}</p>
            <p class="se-fisc__deduct">{se.fiscal.deductible}</p>
            <p class="se-fisc__note">{se.fiscal.note}</p>
          </aside>
        </div>

        <div class="se__cta" data-reveal>
          <a class="btn btn--red btn--lg" href={se.cta.href} data-magnetic>
            {se.cta.label} <span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>
  )}

  {u.criteria && (
    <section class="section criteria">
      <div class={`container criteria__grid ${!u.aside ? 'criteria__grid--solo' : ''}`}>
        <div data-reveal>
          <p class="mono eyebrow">Critères de sélection</p>
          <ul class="criteria__list">
            {u.criteria.map((c, i) => (
              <li><span class="mono">{String(i + 1).padStart(2, '0')}</span> <span class="display">{c}</span></li>
            ))}
          </ul>
        </div>
        {u.aside && (
          <aside class="callout" data-reveal data-delay="0.1">
            <p class="mono eyebrow">{u.aside.title}</p>
            <p class="callout__text">{u.aside.text}</p>
          </aside>
        )}
      </div>
    </section>
  )}

  {u.events && (
    <section class="section events">
      <div class="container">
        <p class="mono eyebrow" data-reveal>Le calendrier</p>
        {[
          { key: 'upcoming', title: 'Événements à venir', items: u.events.upcoming },
          { key: 'past', title: 'Événements passés', items: u.events.past },
        ].filter((g) => g.items && g.items.length).map((g) => (
          <div class={`events__group events__group--${g.key}`}>
            <h3 class="events__group-title display" data-reveal>{g.title}</h3>
            <div class="ecards" data-reveal-group>
              {g.items.map((e, i) => (
                <article class={`ecard ${g.key === 'past' ? 'ecard--past' : ''}`} data-reveal-item>
                  <div class="ecard__top">
                    <span class="ecard__n mono">{String(i + 1).padStart(2, '0')}</span>
                    <div class="ecard__head">
                      <h4 class="ecard__name display">{e.name}</h4>
                      <p class="ecard__meta mono">{e.date} · {e.place}</p>
                    </div>
                    {e.badge && <span class="ecard__badge mono">{e.badge}</span>}
                  </div>

                  {e.teaser && (
                    <p class="ecard__teaser"><span class="ecard__teaser-k mono">Teasing</span> {e.teaser}</p>
                  )}
                  <p class="ecard__desc">{e.desc}</p>
                  {e.note && <p class="ecard__note mono">{e.note}</p>}

                  {g.key === 'past' && e.photos && e.photos.length > 0 && (
                    <div class="ecard__gallery-wrap">
                      <button type="button" class="ecard__gallery" data-gallery-open data-name={e.name} aria-haspopup="dialog">
                        <span class="ecard__gallery-ic" aria-hidden="true">
                          <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
                        </span>
                        Voir les photos <span class="ecard__gallery-n mono">{e.photos.length}</span>
                      </button>
                      {/* Sources listées en HTML (chemins réécrits pour file://) ; masquées et
                          en lazy loading : elles ne sont pas téléchargées, juste lues par la galerie. */}
                      <div class="ecard__photos" hidden data-gallery-src>
                        {e.photos.map((ph, k) => {
                          const src = typeof ph === 'string' ? ph : ph.src;
                          const alt = typeof ph === 'string' ? `${e.name}, photo ${k + 1}` : ph.alt;
                          return <img src={`/img/photos/${src}`} alt={alt} loading="lazy" />;
                        })}
                      </div>
                    </div>
                  )}

                  {e.link && (
                    <a class="btn btn--dark ecard__cta" href={e.link.href} target="_blank" rel="noopener noreferrer" data-magnetic>
                      {e.link.label} <span class="arrow" aria-hidden="true">↗</span>
                    </a>
                  )}

                  {e.signup && (
                    <details class="ev-acc">
                      <summary class="ev-acc__btn btn btn--red">Je m'inscris <span class="ev-acc__chev" aria-hidden="true"></span></summary>
                      <div class="ev-acc__body">
                        <WaitlistForm
                          idPrefix={`ride-${i}`}
                          ctaLabel="Envoyer mon inscription"
                          eventName={e.name}
                          subject={`Inscription ${e.name} - site VELCAP`}
                          context={`pour mon inscription au ${e.name}`}
                          withPhone
                          withMessage
                          success="Merci {firstname}, ton inscription est bien reçue. On revient vers toi très vite."
                        />
                      </div>
                    </details>
                  )}

                  {e.notify && (
                    <details class="ev-acc">
                      <summary class="ev-acc__btn btn btn--red">Être recontacté à l'ouverture <span class="ev-acc__chev" aria-hidden="true"></span></summary>
                      <div class="ev-acc__body">
                        <WaitlistForm
                          idPrefix={`notify-${i}`}
                          ctaLabel="Me prévenir à l'ouverture"
                          eventName={e.name}
                          subject={`Recontact ouverture ${e.name} - site VELCAP`}
                          context={`à l'ouverture des inscriptions du ${e.name}`}
                          success="Merci {firstname}, c'est noté. On te prévient dès l'ouverture des inscriptions."
                        />
                      </div>
                    </details>
                  )}
                </article>
              ))}
            </div>
          </div>
        ))}
        {u.request && <p class="events__request" data-reveal>{u.request}</p>}
      </div>
    </section>
  )}

  {u.events && (
    <div class="gmodal" data-gallery-modal aria-hidden="true">
      <div class="gmodal__backdrop" data-gallery-close></div>
      <div class="gmodal__dialog" role="dialog" aria-modal="true" aria-label="Galerie photo" data-gallery-dialog data-lenis-prevent>
        <button type="button" class="gmodal__x" data-gallery-close aria-label="Fermer la galerie">✕</button>
        <div class="gmodal__stage" data-gallery-stage>
          <button type="button" class="gmodal__arrow gmodal__arrow--prev" data-gallery-prev aria-label="Photo précédente">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5 8 12l7 7"/></svg>
          </button>
          <img class="gmodal__img" data-gallery-img alt="" loading="lazy" draggable="false" />
          <button type="button" class="gmodal__arrow gmodal__arrow--next" data-gallery-next aria-label="Photo suivante">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg>
          </button>
        </div>
        <div class="gmodal__bar">
          <span class="gmodal__title mono" data-gallery-title></span>
          <span class="gmodal__count mono" data-gallery-count></span>
        </div>
      </div>
    </div>
  )}

  {!u.comingSoon && !u.tiers && (
    <section class="ucta section--dark">
      <div class="container ucta__inner">
        <p class="mono eyebrow" data-reveal>Passer à l'action</p>
        <p class="ucta__line display" data-reveal data-delay="0.05">Rejoins <span class="accent">{u.name}.</span></p>
        <button type="button" class="btn btn--red btn--lg" data-open-form data-magnetic>{u.cta} <span class="arrow">→</span></button>
      </div>
    </section>
  )}

  {u.coaches && (
    <section class="section coaches">
      <div class="container">
        <div class="coaches__head" data-reveal>
          <p class="mono eyebrow">L'encadrement</p>
          <h2 class="coaches__title display">Les coachs</h2>
        </div>
        <div class={`coaches__grid coaches__grid--${u.coaches.length}`} data-reveal-group>
          {u.coaches.map((c) => (
            <article class="coach" data-reveal-item>
              <div class="coach__photo">
                <Photo src={c.photo} treatment="bw" slug={u.slug} alt={`${c.name}, entraîneur`} hint={false} />
              </div>
              <div class="coach__body">
                <h3 class="coach__name display">{c.name}</h3>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {u.testimonials && (
    <section class="section testimonials">
      <div class="container">
        <div class="testimonials__head" data-reveal>
          <p class="mono eyebrow">Ils ont été coachés</p>
          <h2 class="testimonials__title display">Leurs retours</h2>
          <p class="testimonials__note mono">Exemples, à remplacer par les vrais témoignages.</p>
        </div>
        <div class="testimonials__grid" data-reveal-group>
          {u.testimonials.map((t) => (
            <figure class="testimonial" data-reveal-item>
              <span class="testimonial__mark" aria-hidden="true">“</span>
              <blockquote class="testimonial__quote">{t.quote}</blockquote>
              <figcaption class="testimonial__by">
                <span class="testimonial__name display">{t.name}</span>
                {t.meta && <span class="testimonial__meta mono">{t.meta}</span>}
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  {gallery && (
    <section class="section ugallery">
      <div class="container">
        <p class="mono eyebrow" data-reveal>En images</p>
        <div class="ugallery__grid" data-reveal-group>
          {gallery.map((src, i) => {
            const gf = galFrame[i] || {};
            return (
              <div class={`ugallery__item ugallery__item--${i} ${gf.wide ? 'ugallery__item--wide' : ''}`} data-reveal-item data-parallax-scope>
                <Photo src={src} treatment="bw" slug={u.slug} parallax={gf.parallax ?? 6} flat={gf.flat || false} alt={`${u.name}, photo ${i + 1}`} />
              </div>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- PREV / NEXT -->
  <nav class="unav" aria-label="Autres univers">
    <a class="unav__link unav__link--prev" href={`/univers/${prev.slug}`}>
      <span class="mono">← {prev.index} Précédent</span>
      <span class="unav__name display">{prev.name}</span>
    </a>
    <a class="unav__link unav__link--next" href={`/univers/${next.slug}`}>
      <span class="mono">Suivant {next.index} →</span>
      <span class="unav__name display">{next.name}</span>
    </a>
  </nav>

  {form && (
    <div class="umodal" data-univers-modal aria-hidden="true">
      <div class="umodal__backdrop" data-modal-close></div>
      <div class="umodal__panel" data-lenis-prevent role="dialog" aria-modal="true" aria-label={form.title}>
        <button type="button" class="umodal__x" data-modal-close aria-label="Fermer">✕</button>
        <p class="mono eyebrow">{u.name}</p>
        <h2 class="umodal__title display">{form.title}</h2>
        <form class="umodal__form" data-univers-form novalidate>
          <input type="hidden" name="access_key" value={site.web3formsKey} />
          <input type="hidden" name="subject" value={`${form.title} - site VELCAP`} />
          <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />
          {form.fields.map((f) => (
            <div class={`field ${f.type === 'textarea' ? 'field--full' : ''}`}>
              <label class="mono" for={`m-${f.name}`}>{f.label}{f.required ? ' *' : ''}</label>
              {f.type === 'textarea' ? (
                <textarea id={`m-${f.name}`} name={f.name} rows="3" required={f.required}></textarea>
              ) : f.type === 'select' ? (
                <select id={`m-${f.name}`} name={f.name} required={f.required}>
                  <option value="" disabled selected>Choisir…</option>
                  {f.options.map((o) => <option>{o}</option>)}
                </select>
              ) : (
                <input id={`m-${f.name}`} name={f.name} type={f.type} required={f.required} />
              )}
            </div>
          ))}

          {u.slug === 'club-ffa' && (
            <label class="consent field--full">
              <input type="checkbox" name="minor_auth" />
              <span>Pour l'adhésion d'un·e mineur·e, je suis le représentant légal et fournirai l'autorisation parentale.</span>
            </label>
          )}
          {!['evenements', 'team-elite', 'coaching', 'team-loisirs'].includes(u.slug) && (
            <label class="consent field--full">
              <input type="checkbox" name="pps" required />
              <span>Je m'engage à compléter le PPS (Parcours de Prévention Santé), obligatoire. *</span>
            </label>
          )}
          <label class="consent field--full">
            <input type="checkbox" name="rgpd" required />
            <span>J'accepte que mes données soient utilisées pour traiter ma demande, conformément à la <a href="/confidentialite" target="_blank">Politique de confidentialité</a>. *</span>
          </label>
          {!['evenements', 'team-elite', 'team-loisirs'].includes(u.slug) && (
            <label class="consent field--full">
              <input type="checkbox" name="image" />
              <span>J'autorise VELCAP à utiliser mon image (photos / vidéos) dans le cadre de sa communication. (facultatif)</span>
            </label>
          )}

          <button type="submit" class="btn btn--red umodal__submit">Envoyer ma demande <span class="arrow">→</span></button>
          <p class="umodal__feedback mono" data-univers-feedback role="status"></p>
        </form>
      </div>
    </div>
  )}

</Base>

<style>
  .uhero { padding-block: clamp(6.5rem, 11vw, 10rem) 0; }
  .uhero__crumb { display: flex; gap: 0.5rem; align-items: center; margin-bottom: clamp(1.6rem, 4vw, 3rem); flex-wrap: wrap; }
  .uhero__crumb a:hover { color: var(--ink); }
  .uhero__crumb .accent { color: var(--red); }
  .uhero__top { display: grid; grid-template-columns: auto 1fr; gap: clamp(1rem, 4vw, 3rem); align-items: start; }
  .uhero__index { font-size: clamp(4rem, 15vw, 12rem); line-height: 0.8; color: var(--red); }
  .uhero__name { font-size: var(--fs-h2); margin: 0.4rem 0 0.9rem; }
  .uhero__lead { font-size: var(--fs-lead); color: #3a3a40; max-width: 30ch; }
  /* hero pleine largeur (full-bleed, bord à bord) */
  .uhero__visual { margin-top: clamp(2rem, 5vw, 4rem); width: 100%; height: clamp(340px, 62vh, 720px); }
  .uhero__visual :global(.ph) { height: 100%; }

  .udetail { padding-block: clamp(2.5rem, 5vw, 4rem); }
  .udetail__intro { font-size: clamp(1.25rem, 1rem + 1vw, 1.7rem); line-height: 1.45; color: var(--ink); font-family: var(--font-body); font-weight: 500; max-width: 60ch; }
  .udetail__intro--justify { text-align: justify; }
  .udetail__note { margin-top: 1.2rem; color: var(--smoke); max-width: 60ch; letter-spacing: 0.06em; }

  /* — Essai gratuit — */
  .freetrial { padding-block: clamp(1rem, 2vw, 1.5rem); }
  .freetrial__inner {
    display: flex; align-items: center; justify-content: space-between; gap: clamp(1.4rem, 3vw, 2.5rem);
    flex-wrap: wrap; background: var(--white); border: 1px solid var(--hairline); border-left: 5px solid var(--red);
    border-radius: 16px; padding: clamp(1.5rem, 3vw, 2.4rem); box-shadow: var(--shadow);
  }
  .freetrial__copy .eyebrow { color: var(--red); }
  .freetrial__title { font-size: clamp(1.6rem, 4vw, 2.6rem); margin: 0.5rem 0 0.5rem; }
  .freetrial__text { color: #4a4a50; max-width: 52ch; }
  .freetrial__cta { flex-shrink: 0; }

  /* — Coachs — */
  .coaches__head { margin-bottom: clamp(1.4rem, 3vw, 2rem); }
  .coaches__title { font-size: var(--fs-h3); margin: 0.4rem 0 0.4rem; }
  .coaches__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1rem, 2vw, 1.6rem); }
  /* colonnes selon le nombre de coachs (2 -> largeur limitée, 4 -> quatre de front) */
  .coaches__grid--2 { grid-template-columns: repeat(2, 1fr); max-width: 660px; }
  .coaches__grid--4 { grid-template-columns: repeat(4, 1fr); }
  .coach { background: var(--white); border: 1px solid var(--hairline); border-radius: 16px; overflow: hidden; box-shadow: var(--shadow); transition: transform 0.4s var(--ease), box-shadow 0.4s var(--ease); }
  .coach:hover { transform: translateY(-4px); }
  .coach__photo { position: relative; aspect-ratio: 4 / 5; }
  .coach__body { padding: 1.1rem 1.2rem 1.4rem; }
  .coach__name { font-size: clamp(1.3rem, 2.4vw, 1.85rem); margin: 0; }

  /* — Témoignages — */
  .testimonials__head { margin-bottom: clamp(1.4rem, 3vw, 2rem); }
  .testimonials__title { font-size: var(--fs-h3); margin: 0.4rem 0 0.4rem; }
  .testimonials__note { color: var(--smoke); text-transform: none; letter-spacing: 0.04em; }
  .testimonials__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1rem, 2vw, 1.6rem); }
  .testimonial { position: relative; display: flex; flex-direction: column; gap: 0.9rem; background: var(--white); border: 1px solid var(--hairline); border-left: 4px solid var(--red); border-radius: 16px; padding: clamp(1.4rem, 2.5vw, 2rem); box-shadow: var(--shadow); }
  .testimonial__mark { font-family: var(--font-display); color: var(--red); font-size: 3.2rem; line-height: 0.6; height: 1.4rem; }
  .testimonial__quote { color: #2a2a2e; font-size: 1.02rem; line-height: 1.55; }
  .testimonial__by { display: grid; gap: 0.15rem; margin-top: auto; padding-top: 0.6rem; border-top: 1px solid var(--hairline); }
  .testimonial__name { font-size: clamp(1.15rem, 2vw, 1.5rem); }
  .testimonial__meta { color: var(--red); }

  .points { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0; }
  .point { display: grid; grid-template-columns: 3rem 1fr; gap: 1rem; padding: clamp(1.2rem, 2.5vw, 1.8rem) 1.5rem clamp(1.2rem, 2.5vw, 1.8rem) 0; border-top: 1px solid var(--hairline); }
  .point__n { color: var(--red); padding-top: 0.35rem; }
  .point__k { font-size: var(--fs-h3); margin-bottom: 0.3rem; }
  .point__v { color: #4a4a50; }

  /* horaires à gauche, lieux à droite, alignés sur la même ligne */
  .schedule__grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1.6rem, 4vw, 3.5rem); align-items: start; border-top: 1px solid var(--hairline); padding-top: clamp(1.5rem, 3vw, 2.5rem); }
  .schedule__list { display: grid; gap: 0.6rem; margin-top: 1rem; }
  .schedule__list li { font-size: clamp(1.4rem, 3vw, 2.2rem); }
  .schedule__places-text { color: #2a2a2e; font-size: clamp(1.05rem, 0.98rem + 0.5vw, 1.35rem); line-height: 1.5; margin-top: 1rem; max-width: 42ch; }
  .schedule__places-note { color: var(--red); text-transform: none; letter-spacing: 0.04em; margin-top: 0.9rem; }
  .schedule__tarif { display: flex; align-items: baseline; gap: 0.6rem 1.4rem; flex-wrap: wrap; margin-top: clamp(1.8rem, 3.5vw, 2.6rem); padding-top: clamp(1.4rem, 3vw, 2rem); border-top: 1px solid var(--hairline); }
  .schedule__tarif > .mono { color: var(--smoke); }
  .schedule__q { font-size: clamp(2.6rem, 7vw, 5rem); color: var(--red); line-height: 1; }
  .schedule__note { color: var(--smoke); align-self: center; }

  .tiers__grid { display: grid; gap: clamp(1rem, 2vw, 1.5rem); margin-top: 1.5rem; }
  .tiers__grid--2 { grid-template-columns: repeat(2, 1fr); }
  .tiers__grid--3 { grid-template-columns: repeat(3, 1fr); }
  .tier {
    position: relative; display: flex; flex-direction: column; gap: 0.7rem;
    background: var(--white); border: 1px solid var(--hairline); border-radius: 16px;
    padding: clamp(1.4rem, 2.5vw, 2rem);
  }
  .tier--hl { border-color: var(--ink); box-shadow: var(--shadow); }
  .tier__badge { position: absolute; top: -0.7rem; left: 1.4rem; background: var(--red); color: #fff; padding: 0.25rem 0.7rem; border-radius: 999px; }
  .tier__name { font-size: clamp(1.5rem, 3vw, 2rem); }
  .tier__price { font-size: clamp(2rem, 4vw, 3rem); color: var(--red); line-height: 1; }
  .tier__per { font-size: 0.4em; color: var(--smoke); letter-spacing: 0.04em; margin-left: 0.25em; }
  .tier__ast { color: var(--red); font-size: 0.5em; vertical-align: super; margin-left: 0.1em; }
  .tier__sub { color: var(--smoke); text-transform: none; letter-spacing: 0.03em; margin-top: -0.2rem; }
  .tier__short { color: #4a4a50; font-size: 0.85rem; margin-top: 0.15rem; }
  .tier__short strong { color: var(--ink); font-weight: 600; }
  .tier__price--soft { color: var(--smoke); font-size: 0.9rem; }
  .tier__tagline { color: #4a4a50; }
  .tier__features { display: grid; gap: 0.5rem; margin: 0.4rem 0 1rem; }
  .tier__features li { position: relative; padding-left: 1.4rem; color: #2a2a2e; font-size: 0.98rem; }
  .tier__features li::before { content: ""; position: absolute; left: 0; top: 0.55em; width: 8px; height: 8px; background: var(--red); clip-path: polygon(0 0, 100% 50%, 0 100%); }
  /* avantage à détail dépliable (courses objectifs) : carte compacte par défaut,
     déplié au clic/tap — fonctionne sur mobile sans JS ni survol */
  .feat-acc__sum { list-style: none; cursor: pointer; display: inline-flex; align-items: center; gap: 0.45rem; color: #2a2a2e; transition: color 0.25s var(--ease); }
  .feat-acc__sum::-webkit-details-marker { display: none; }
  .feat-acc__sum::after { content: ""; width: 6px; height: 6px; border-right: 1.6px solid var(--red); border-bottom: 1.6px solid var(--red); transform: rotate(45deg); transition: transform 0.25s var(--ease); }
  .feat-acc[open] .feat-acc__sum::after { transform: rotate(-135deg); }
  .feat-acc__sum:hover { color: var(--ink); }
  .feat-acc__lead { margin: 0.55rem 0 0.1rem; color: #2a2a2e; font-size: 0.86rem; font-weight: 600; }
  .feat-acc__list { display: grid; gap: 0.3rem; margin: 0.35rem 0 0.1rem; }
  .tier__features .feat-acc__list li { padding-left: 0.95rem; color: #6a6a70; font-size: 0.84rem; }
  .tier__features .feat-acc__list li::before { top: 0.6em; width: 6px; height: 1.6px; background: var(--smoke); clip-path: none; }
  .tier__soon { color: var(--smoke); margin: 0.6rem 0 1rem; }
  .tier__cta { margin-top: auto; justify-content: center; }
  .tiers__note {
    margin-top: clamp(1.6rem, 3vw, 2.4rem);
    display: flex; align-items: center; gap: 0.9rem;
    width: fit-content; max-width: 100%;
    background: var(--white); border: 1px solid var(--hairline); border-left: 5px solid var(--red);
    border-radius: 12px; padding: 0.95rem 1.35rem; box-shadow: var(--shadow);
    color: var(--ink); font-size: clamp(1rem, 0.92rem + 0.3vw, 1.18rem); font-weight: 500; line-height: 1.4;
  }
  .tiers__note-star {
    flex-shrink: 0; display: grid; place-items: center; width: 1.9rem; height: 1.9rem;
    border-radius: 50%; background: var(--red); color: #fff; font-weight: 700; font-size: 1.15rem; line-height: 1;
  }
  /* conditions d'engagement (coaching) */
  .engage-cond {
    margin-top: clamp(1.6rem, 3vw, 2.4rem);
    background: var(--white); border: 1px solid var(--hairline); border-left: 5px solid var(--ink);
    border-radius: 14px; padding: clamp(1.2rem, 2.5vw, 1.8rem) clamp(1.4rem, 3vw, 2rem); box-shadow: var(--shadow);
  }
  .engage-cond__title { color: var(--ink); font-size: 0.82rem; margin-bottom: 0.85rem; }
  .engage-cond__list { display: grid; gap: 0.6rem; }
  .engage-cond__list li { position: relative; padding-left: 1.5rem; color: #33333a; line-height: 1.45; }
  .engage-cond__list li::before { content: ""; position: absolute; left: 0; top: 0.5em; width: 8px; height: 8px; background: var(--red); clip-path: polygon(0 0, 100% 50%, 0 100%); }

  .criteria__grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .criteria__grid--solo { grid-template-columns: 1fr; }
  .criteria__list { display: grid; gap: 0.2rem; margin-top: 1rem; }
  .criteria__list li { display: grid; grid-template-columns: 2.5rem 1fr; align-items: center; gap: 1rem; padding: clamp(0.7rem, 1.6vw, 1.1rem) 0; border-top: 1px solid var(--hairline); }
  .criteria__list .mono { color: var(--red); }
  .criteria__list .display { font-size: clamp(1.2rem, 2.4vw, 1.8rem); }
  .callout { background: var(--ink); color: #fff; border-radius: 16px; padding: clamp(1.5rem, 3vw, 2.2rem); }
  .callout .eyebrow { color: var(--red-bright); margin-bottom: 0.8rem; }
  .callout__text { color: #c8c8cf; }

  /* — Événements (cliquables, en deux groupes) — */
  .events__group + .events__group { margin-top: clamp(2.4rem, 5vw, 3.8rem); }
  .events__group-title { font-size: var(--fs-h3); margin: clamp(1.4rem, 3vw, 2.2rem) 0 0.2rem; }
  .events__group--past .events__group-title { color: var(--smoke); }

  /* Cartes d'événement */
  .ecards { margin-top: 1.5rem; display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1rem, 2vw, 1.5rem); align-items: start; }
  .ecard { display: flex; flex-direction: column; background: var(--white); border: 1px solid var(--hairline); border-radius: 16px; padding: clamp(1.3rem, 2.5vw, 1.9rem); box-shadow: var(--shadow); }
  .ecard--past { background: transparent; box-shadow: none; }
  .ecard__top { display: grid; grid-template-columns: auto 1fr auto; align-items: baseline; gap: 0.5rem 1rem; }
  .ecard__n { color: var(--red); }
  .ecard__name { font-size: clamp(1.3rem, 2.4vw, 1.9rem); line-height: 1; }
  .ecard--past .ecard__name { color: #55555c; }
  .ecard__meta { color: var(--smoke); margin-top: 0.4rem; }
  .ecard__badge { justify-self: end; align-self: start; white-space: nowrap; color: var(--red); border: 1px solid var(--red); border-radius: 999px; padding: 0.25rem 0.65rem; font-size: 0.62rem; }
  .ecard__teaser { margin-top: 0.9rem; display: flex; align-items: baseline; gap: 0.55rem; color: var(--ink); font-weight: 600; line-height: 1.4; }
  .ecard__teaser-k { flex-shrink: 0; color: #fff; background: var(--red); border-radius: 999px; padding: 0.2rem 0.6rem; font-size: 0.6rem; }
  .ecard__desc { margin-top: 0.9rem; color: #2a2a2e; line-height: 1.55; }
  .ecard--past .ecard__desc { color: #4a4a50; }
  .ecard__note { margin-top: 0.8rem; color: var(--smoke); text-transform: none; letter-spacing: 0.02em; line-height: 1.45; }
  .ecard__cta { align-self: flex-start; margin-top: 1.2rem; }
  .events__request { margin-top: clamp(2rem, 4vw, 3rem); font-size: var(--fs-lead); color: #3a3a40; max-width: 44ch; }

  /* Bloc dépliable (inscription / recontact) dans une carte */
  .ev-acc { margin-top: 1.2rem; }
  .ev-acc__btn { list-style: none; justify-content: center; width: 100%; cursor: pointer; }
  .ev-acc__btn::-webkit-details-marker { display: none; }
  .ev-acc__chev { width: 7px; height: 7px; border-right: 2px solid currentColor; border-bottom: 2px solid currentColor; transform: rotate(45deg); transition: transform 0.25s var(--ease); }
  .ev-acc[open] .ev-acc__chev { transform: rotate(-135deg); }
  .ev-acc__body { margin-top: 0.9rem; }

  /* Déclencheur de galerie (compact, hauteur fixe : ne décale pas la carte) */
  .ecard__gallery { align-self: flex-start; margin-top: 1.2rem; display: inline-flex; align-items: center; gap: 0.55rem;
    padding: 0.6rem 1rem; border-radius: 999px; border: 1px solid var(--hairline); background: var(--white);
    font-family: var(--font-mono); font-size: 0.72rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink);
    cursor: pointer; transition: border-color 0.3s var(--ease), color 0.3s var(--ease); }
  .ecard__gallery:hover { border-color: var(--red); color: var(--red); }
  .ecard__gallery-ic { display: grid; place-items: center; color: var(--red); }
  .ecard__gallery-n { color: var(--smoke); }
  .ecard__photos { display: none; }

  /* Galerie photo en modale, mesurée et centrée */
  .gmodal { position: fixed; inset: 0; z-index: 130; display: grid; place-items: center; padding: 1.2rem;
    opacity: 0; visibility: hidden; transition: opacity 0.3s var(--ease), visibility 0.3s; }
  .gmodal.is-open { opacity: 1; visibility: visible; }
  .gmodal__backdrop { position: absolute; inset: 0; background: rgba(6,6,8,.72); backdrop-filter: blur(4px); }
  .gmodal__dialog { position: relative; width: min(680px, 92vw); max-height: 86vh; display: flex; flex-direction: column;
    background: var(--ink); border-radius: 16px; overflow: hidden; box-shadow: 0 40px 80px -30px rgba(0,0,0,.7);
