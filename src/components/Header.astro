---
import { univers } from '../data/univers.js';
---
<header class="site-header" data-header>
  <div class="site-header__bar">
    <a class="brand" href="/" aria-label="VELCAP — accueil">
      <img src="/img/velcap-logo.svg" alt="VELCAP" width="447" height="140" />
    </a>

    <nav class="site-header__nav" aria-label="Principale">
      <a href="/#univers">Les univers</a>
      <a href="/univers/corrida">La Corrida</a>
      <a href="/univers/coaching">Coaching</a>
    </nav>

    <div class="site-header__actions">
      <a class="btn btn--red header-cta" href="/#engager">
        S'engager <span class="arrow" aria-hidden="true">↗</span>
      </a>
      <button class="menu-toggle" data-menu-toggle aria-expanded="false" aria-controls="navmenu">
        <span class="menu-toggle__label">Menu</span>
        <span class="menu-toggle__bars" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>
</header>

<div class="navmenu" id="navmenu" data-menu aria-hidden="true">
  <div class="navmenu__inner">
    <p class="mono navmenu__eyebrow">Index — 07 univers</p>
    <ul class="navmenu__list">
      {univers.map((u) => (
        <li class="navmenu__item">
          <a href={`/univers/${u.slug}`} data-menu-link>
            <span class="navmenu__idx mono">{u.index}</span>
            <span class="navmenu__name display">{u.name}</span>
            <span class="navmenu__disc mono">{u.discipline}</span>
          </a>
        </li>
      ))}
    </ul>
    <div class="navmenu__foot">
      <a href="/" data-menu-link class="mono">↩ Accueil</a>
      <a href="/#engager" data-menu-link class="mono">S'engager →</a>
    </div>
  </div>
</div>

<style>
  .site-header {
    position: fixed; inset: 0 0 auto 0; z-index: 90;
    transition: transform 0.45s var(--ease), background 0.4s var(--ease), border-color 0.4s var(--ease);
    border-bottom: 1px solid transparent;
  }
  .site-header.is-stuck {
    background: color-mix(in srgb, var(--paper) 80%, transparent);
    backdrop-filter: blur(14px) saturate(1.2);
    border-bottom-color: var(--hairline);
  }
  .site-header.is-hidden { transform: translateY(-101%); }

  .site-header__bar {
    display: flex; align-items: center; gap: 1.5rem;
    width: 100%; max-width: var(--container); margin-inline: auto;
    padding: 0.85rem var(--gutter);
  }
  .brand img { height: 26px; width: auto; }
  .site-header__nav { display: flex; gap: 1.6rem; margin-left: auto; }
  .site-header__nav a {
    font-family: var(--font-mono); font-size: 0.74rem; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--ink); position: relative; padding-block: 0.3rem;
  }
  .site-header__nav a::after {
    content: ""; position: absolute; left: 0; right: 100%; bottom: 0; height: 1.5px;
    background: var(--red); transition: right 0.3s var(--ease);
  }
  .site-header__nav a:hover::after { right: 0; }

  .site-header__actions { display: flex; align-items: center; gap: 0.9rem; margin-left: 0; }
  .site-header__nav + .site-header__actions { margin-left: 0; }
  .header-cta { padding: 0.7rem 1.1rem; }

  .menu-toggle {
    display: inline-flex; align-items: center; gap: 0.6rem; cursor: pointer;
    background: transparent; border: 0; color: var(--ink);
    font-family: var(--font-mono); font-size: 0.74rem; letter-spacing: 0.12em; text-transform: uppercase;
  }
  .menu-toggle__bars { display: inline-grid; gap: 4px; width: 22px; }
  .menu-toggle__bars i { height: 1.5px; background: currentColor; transition: transform 0.3s var(--ease); }
  .menu-toggle[aria-expanded="true"] .menu-toggle__bars i:first-child { transform: translateY(2.75px) rotate(45deg); }
  .menu-toggle[aria-expanded="true"] .menu-toggle__bars i:last-child { transform: translateY(-2.75px) rotate(-45deg); }

  /* — Overlay — */
  .navmenu {
    position: fixed; inset: 0; z-index: 95; background: var(--ink); color: var(--white);
    clip-path: inset(0 0 100% 0); pointer-events: none;
    transition: clip-path 0.7s var(--ease-out);
    display: grid; align-items: center;
  }
  .navmenu.is-open { clip-path: inset(0 0 0% 0); pointer-events: auto; }
  .navmenu__inner { width: 100%; max-width: var(--container); margin-inline: auto; padding: 7rem var(--gutter) 3rem; }
  .navmenu__eyebrow { color: #6f6f77; margin-bottom: 1.4rem; }
  .navmenu__list { border-top: 1px solid var(--hairline-d); }
  .navmenu__item { border-bottom: 1px solid var(--hairline-d); }
  .navmenu__item a {
    display: grid; grid-template-columns: 3rem 1fr auto; align-items: center; gap: 1.2rem;
    padding: clamp(0.7rem, 1.8vw, 1.3rem) 0; color: var(--white);
    transition: padding-left 0.4s var(--ease), color 0.3s var(--ease);
  }
  .navmenu__item a:hover { padding-left: 1.4rem; color: var(--red-bright); }
  .navmenu__idx { color: #6f6f77; }
  .navmenu__item a:hover .navmenu__idx { color: var(--red-bright); }
  .navmenu__name { font-size: clamp(1.7rem, 5vw, 3.4rem); }
  .navmenu__disc { color: #6f6f77; }
  .navmenu__foot { display: flex; justify-content: space-between; gap: 1rem; margin-top: 2.2rem; }
  .navmenu__foot a { color: #b9b9c0; }
  .navmenu__foot a:hover { color: var(--white); }

  @media (max-width: 860px) {
    .site-header__nav { display: none; }
    .header-cta { display: none; }
    .site-header__actions { margin-left: auto; }
  }
</style>
