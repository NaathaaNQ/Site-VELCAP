---
import { site } from '../data/site.js';
// variant : 'icon' (icône seule, header) | 'labeled' (icône + nom, footer/contact)
const { variant = 'icon', class: cls = '' } = Astro.props;
---
<ul class={`socials socials--${variant} ${cls}`}>
  {site.socials.map((s) => (
    <li>
      <a href={s.url} target="_blank" rel="noopener noreferrer" aria-label={`${s.name} VELCAP`}>
        {s.icon === 'instagram' && (
          <svg class="socials__ic" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7">
            <rect x="3" y="3" width="18" height="18" rx="5" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none" />
          </svg>
        )}
        {variant === 'labeled' && <span class="socials__name mono">{s.name}</span>}
      </a>
    </li>
  ))}
</ul>

<style>
  .socials { display: flex; align-items: center; gap: 0.6rem; }
  .socials a {
    display: inline-flex; align-items: center; gap: 0.55rem;
    color: currentColor; transition: color 0.25s var(--ease), transform 0.25s var(--ease);
  }
  .socials__ic {
    width: 38px; height: 38px; padding: 8px; border-radius: 50%;
    border: 1.5px solid currentColor; transition: background 0.25s var(--ease), color 0.25s var(--ease);
  }
  .socials a:hover { color: var(--red); }
  .socials a:hover .socials__ic { background: var(--red); border-color: var(--red); color: #fff; transform: translateY(-1px); }
  .socials--labeled a { gap: 0.7rem; }
  .socials__name { color: inherit; letter-spacing: 0.14em; }
</style>
