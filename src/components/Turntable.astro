---
import { univers } from '../data/univers.js';
import Photo from './Photo.astro';
const total = String(univers.length).padStart(2, '0');
---
<section class="tt" id="univers" data-parallax-scope>
  <div class="container tt__head">
    <div>
      <p class="mono eyebrow" data-reveal>Glisse · clique · explore</p>
      <h2 class="tt__title display" data-reveal data-delay="0.05">La plateforme<br />tournante</h2>
    </div>
    <p class="tt__lead" data-reveal data-delay="0.1">
      Fais tourner, ouvre l'univers qui te ressemble.
    </p>
  </div>

  <div class="tt__stage" data-turntable role="group" aria-roledescription="carrousel" aria-label="Les univers VELCAP">
    <div class="tt__deck">
      {univers.map((u) => (
        <article class="tt-panel" data-panel data-name={u.name} aria-hidden="true">
          <a class="board" href={`/univers/${u.slug}`}>
            <div class="board__visual">
              <Photo src={`tt-${u.slug}.jpg`} treatment="color" slug={u.slug} alt={u.name} hint={false} />
            </div>
            <div class="board__body">
              <div class="board__row">
                <span class="board__idx mono">{u.index} / {total}</span>
                <span class="board__disc mono">{u.discipline}</span>
              </div>
              <h3 class="board__name display">{u.name}</h3>
              <p class="board__lead">{u.lead}</p>
              <span class="board__cta mono">Explorer l'univers <span class="arrow" aria-hidden="true">→</span></span>
            </div>
          </a>
        </article>
      ))}
    </div>

    <button class="tt-arrow tt-arrow--prev" data-tt-prev aria-label="Univers précédent">
      <svg viewBox="0 0 24 24" width="21" height="21" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5 8 12l7 7" /></svg>
    </button>
    <button class="tt-arrow tt-arrow--next" data-tt-next aria-label="Univers suivant">
      <svg viewBox="0 0 24 24" width="21" height="21" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="m9 5 7 7-7 7" /></svg>
    </button>
  </div>

  <div class="container tt__controls">
    <button class="tt-auto" data-tt-auto aria-pressed="false">
      <span class="tt-auto__dot" aria-hidden="true"></span> Rotation auto
    </button>
    <div class="tt__dots" role="tablist" aria-label="Choisir un univers">
      {univers.map((u) => (
        <button class="tt-dot" data-tt-dot role="tab" aria-label={u.name}></button>
      ))}
    </div>
    <p class="tt__counter mono">
      <span data-tt-now>01</span><i>/</i>{total} · <span data-tt-name>{univers[0].name}</span>
    </p>
  </div>
</section>

<style>
  .tt { padding-block: clamp(2.5rem, 5vw, 5rem); background: var(--paper); overflow: hidden; }
  .tt__head {
    display: grid; grid-template-columns: 1.4fr 1fr; gap: 2rem; align-items: end;
    margin-bottom: clamp(2rem, 5vw, 4rem);
  }
  .tt__title { font-size: var(--fs-h2); margin-top: 0.8rem; }
  .tt__lead { font-size: var(--fs-lead); color: #44444a; max-width: 38ch; }

  .tt__stage {
    position: relative; height: clamp(470px, 64vh, 640px);
    perspective: 2000px; touch-action: pan-y; cursor: grab;
    background: radial-gradient(130% 100% at 50% 14%, #191920 0%, #0c0c0f 55%, #070708 100%);
    border: 1px solid #1b1b21; border-radius: 24px; overflow: hidden;
    box-shadow: inset 0 1px 0 rgba(255,255,255,.04), 0 40px 90px -50px rgba(0,0,0,.7);
  }
  .tt__stage:active { cursor: grabbing; }
  /* halo rouge d'ambiance */
  .tt__stage::before {
    content: ""; position: absolute; left: 50%; top: 40%; transform: translate(-50%, -50%);
    width: 62%; height: 58%; z-index: 0; pointer-events: none;
    background: radial-gradient(closest-side, rgba(226,0,15,.30), transparent 72%);
    filter: blur(26px);
  }
  /* grounding : ombre de sol */
  .tt__stage::after {
    content: ""; position: absolute; left: 50%; bottom: 7%; transform: translateX(-50%);
    width: 46%; height: 60px; z-index: 0; pointer-events: none;
    background: radial-gradient(closest-side, rgba(0,0,0,.55), transparent 75%);
    filter: blur(8px);
  }
  .tt__deck { position: absolute; inset: 0; transform-style: preserve-3d; z-index: 1; }

  .tt-panel {
    position: absolute; top: 50%; left: 50%;
    width: min(388px, 78vw); height: clamp(410px, 56vh, 550px);
    transform: translate(-50%, -50%);
    will-change: transform, opacity;
  }
  .board {
    position: relative;
    display: flex; flex-direction: column; height: 100%; color: var(--white);
    background: linear-gradient(168deg, #1b1b22 0%, #121217 48%, #0c0c10 100%);
    border: 1px solid #2c2c34; border-radius: 18px; overflow: hidden;
    box-shadow: 0 34px 70px -34px rgba(0,0,0,.75), inset 0 1px 0 rgba(255,255,255,.05);
    transition: box-shadow 0.45s var(--ease), border-color 0.45s var(--ease);
  }
  /* sheen diagonal subtil */
  .board::before {
    content: ""; position: absolute; inset: 0; z-index: 3; pointer-events: none;
    background: linear-gradient(135deg, rgba(255,255,255,.06), transparent 38%);
  }
  /* voile de profondeur : assombrit les panneaux latéraux (piloté par --dim en JS,
     opacity composité = fluide, aucun repaint coûteux) */
  .board::after {
    content: ""; position: absolute; inset: 0; z-index: 4; pointer-events: none;
    background: #07070a; opacity: var(--dim, 0);
    transition: opacity 0.25s linear;
  }
  .tt-panel.is-active .board {
    border-color: var(--red);
    box-shadow: 0 50px 100px -36px rgba(226,0,15,.55), 0 0 0 1px rgba(226,0,15,.6), inset 0 1px 0 rgba(255,255,255,.06);
  }
  .board__visual { position: relative; height: 56%; border-bottom: 1px solid #26262d; }
  .board__visual::after {
    content: ""; position: absolute; left: 0; right: 0; top: 0; height: 3px; z-index: 2;
    background: linear-gradient(90deg, var(--red), var(--red-bright));
  }
  .board__body { padding: 1.3rem 1.4rem 1.5rem; display: flex; flex-direction: column; gap: 0.5rem; flex: 1; }
  .board__row { display: flex; justify-content: space-between; }
  .board__idx { color: var(--red-bright); }
  .board__disc { color: #7a7a82; }
  .board__name { font-size: clamp(1.8rem, 5vw, 2.6rem); margin-top: 0.1rem; }
  .board__lead { color: #b9b9c0; font-size: 0.98rem; }
  .board__cta { margin-top: auto; color: #fff; display: inline-flex; gap: 0.5rem; align-items: center; }
  .board__cta .arrow { color: var(--red-bright); transition: transform 0.3s var(--ease); }
  .tt-panel.is-active .board:hover { border-color: var(--red-bright); }
  .tt-panel.is-active .board:hover .board__cta .arrow { transform: translateX(5px); }

  /* flèches premium : verre dépoli sur la scène sombre, liseré fin, halo rouge au survol */
  .tt-arrow {
    position: absolute; top: 50%; transform: translateY(-50%); z-index: 50;
    width: 60px; height: 60px; border-radius: 50%; cursor: pointer;
    display: grid; place-items: center; color: #fff;
    background: rgba(18, 18, 22, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.18);
    -webkit-backdrop-filter: blur(10px) saturate(1.25);
    backdrop-filter: blur(10px) saturate(1.25);
    box-shadow: 0 12px 34px -14px rgba(0, 0, 0, 0.65), inset 0 1px 0 rgba(255, 255, 255, 0.16);
    transition: background 0.4s var(--ease), border-color 0.4s var(--ease),
                transform 0.4s var(--ease-out), box-shadow 0.4s var(--ease);
  }
  .tt-arrow svg { transition: transform 0.4s var(--ease-out); }
  .tt-arrow:hover {
    background: var(--red); border-color: var(--red);
    transform: translateY(-50%) scale(1.08);
    box-shadow: 0 18px 42px -12px rgba(226, 0, 15, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.22);
  }
  .tt-arrow:active { transform: translateY(-50%) scale(0.95); }
  .tt-arrow--prev:hover svg { transform: translateX(-3px); }
  .tt-arrow--next:hover svg { transform: translateX(3px); }
  .tt-arrow--prev { left: clamp(0.6rem, 3vw, 2.4rem); }
  .tt-arrow--next { right: clamp(0.6rem, 3vw, 2.4rem); }

  .tt__controls {
    display: flex; align-items: center; justify-content: space-between; gap: 1.5rem;
    margin-top: 2.4rem; flex-wrap: wrap;
  }
  .tt-auto {
    display: inline-flex; align-items: center; gap: 0.6rem; cursor: pointer;
    background: transparent; border: 1.5px solid var(--ink); border-radius: 999px;
    padding: 0.5rem 1rem; font-family: var(--font-mono); font-size: 0.72rem;
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink);
    transition: all 0.3s var(--ease);
  }
  .tt-auto__dot { width: 8px; height: 8px; border-radius: 50%; border: 1.5px solid currentColor; }
  .tt-auto[aria-pressed="true"] { background: var(--red); border-color: var(--red); color: #fff; }
  .tt-auto[aria-pressed="true"] .tt-auto__dot { background: #fff; border-color: #fff; }

  .tt__dots { display: flex; gap: 0.55rem; }
  .tt-dot {
    width: 10px; height: 10px; border-radius: 50%; cursor: pointer; padding: 0;
    background: transparent; border: 1.5px solid #b3b3b3; transition: all 0.25s var(--ease);
  }
  .tt-dot.is-active { background: var(--red); border-color: var(--red); transform: scale(1.3); }

  .tt__counter { color: var(--ink); font-size: 0.95rem; letter-spacing: 0.1em; }
  .tt__counter i { color: var(--smoke); margin: 0 0.2rem; font-style: normal; }
  .tt__counter [data-tt-now] { color: var(--red); }

  /* desktop : plateforme plus large et panneaux un peu plus grands */
  @media (min-width: 1101px) {
    .tt__stage { height: clamp(500px, 66vh, 680px); }
    .tt-panel { width: min(420px, 40vw); height: clamp(430px, 58vh, 580px); }
  }

  @media (max-width: 760px) {
    .tt__head { grid-template-columns: 1fr; align-items: start; }
    .tt-arrow { width: 50px; height: 50px; }
    .tt-arrow svg { width: 18px; height: 18px; }
    .tt__controls { justify-content: center; }
  }
</style>
