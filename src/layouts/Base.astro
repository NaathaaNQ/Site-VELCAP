---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const {
  title = 'VELCAP · Structure sportive',
  description = "VELCAP réunit six univers sous une même bannière : team loisirs, team élite, club FFA (athlétisme), club FFC (cyclisme), nos événements et le coaching privé.",
  theme = 'light', // 'light' | 'dark' (couleur de la barre + header de départ)
} = Astro.props;
---
<!doctype html>
<html lang="fr" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0b" />
    <link rel="icon" type="image/svg+xml" href="/img/velcap-logo.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <link rel="preload" href="/fonts/BigShoulders-Bold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Outfit-Regular.woff2" as="font" type="font/woff2" crossorigin />

    <script is:inline>
      document.documentElement.classList.remove('no-js');
    </script>
  </head>
  <body data-theme={theme}>
    <a href="#main" class="skip">Aller au contenu</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      import { initSite } from '../scripts/main.js';
      initSite();
    </script>
  </body>
</html>
