---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const {
  title = 'VELCAP — Structure sportive',
  description = "VELCAP réunit sept univers sous une même bannière : association, athlétisme (FFA), cyclisme (FFC), team élite, la Corrida, nos actions et le coaching privé.",
  theme = 'light', // 'light' | 'dark' (couleur de la barre + header de départ)
} = Astro.props;
---
<!doctype html>
<html lang="fr" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0b" />
    <link rel="icon" type="image/svg+xml" href="/img/velcap-logo.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      document.documentElement.classList.remove('no-js');
    </script>
  </head>
  <body data-theme={theme}>
    <a href="#main" class="skip">Aller au contenu</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      import { initSite } from '../scripts/main.js';
      initSite();
    </script>
  </body>
</html>
